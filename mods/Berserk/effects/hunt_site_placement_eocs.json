                ]
              },
              {
                "overmap_at_point": "berserk_local_breach",
                "point": {
                  "context_val": "berserk_site_breach_candidate"
                }
              }
            ]
          },
          "then": [
            {
              "u_message": "An existing unique site lies outside the preferred spacing. Its position is preserved and the objective is registered there.",
              "type": "warning"
            },
            {
              "copy_var": {
                "context_val": "berserk_site_breach_candidate"
              },
              "target_var": {
                "u_val": "berserk_local_breach_location"
