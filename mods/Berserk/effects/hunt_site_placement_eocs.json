[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_SITE_BREACH_VALIDATE",
    "effect": {
      "if": {
        "overmap_at_point": "berserk_local_breach",
        "point": {
          "context_val": "berserk_site_breach_candidate"
        }
      },
      "then": [
        {
          "copy_var": {
            "context_val": "berserk_site_breach_candidate"
          },
          "target_var": {
            "u_val": "berserk_local_breach_location"
          }
        },
        {
          "run_eocs": "EOC_BERSERK_BREACH_FOUND"
        }
      ],
      "else": {
        "run_eocs": "EOC_BERSERK_SITE_BREACH_FAILED"
      }
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_SITE_BREACH_FAILED",
    "effect": {
      "if": {
        "math": [
          "u_berserk_site_breach_tries < 2"
        ]
      },
      "then": {
        "run_eocs": "EOC_BERSERK_BREACH_FIND"
      },
      "else": {
        "run_eocs": "EOC_BERSERK_SITE_BREACH_MESSAGE"
      }
    }
  },
