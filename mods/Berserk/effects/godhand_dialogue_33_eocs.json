                "math": [
                  "n_monsters_nearby('mon_berserk_godhand_ubik', 'radius': 0, 'attitude': 'both') > 0"
                ]
              }
            ]
          },
          "then": {
            "u_message": "Убик: Теперь посмотрим, сумеешь ли ты добраться до дороги назад.\n\nПять голосов умолкают. У начала тропы разрывается сомкнувшийся проход.",
            "type": "bad",
            "popup": false
          },
          "else": {
            "if": {
              "and": [
