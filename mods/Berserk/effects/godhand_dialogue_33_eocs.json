                  "math": [
                    "n_monsters_nearby('mon_berserk_godhand_conrad', 'radius': 0, 'attitude': 'both') > 0"
                  ]
                }
              ]
            },
            "then": {
              "u_message": "Поворачивается к герою всем корпусом — медленно, как и всё, что он делает. Больше не произносит ни слова.\n\nПять голосов умолкают. У начала тропы разрывается сомкнувшийся проход.",
              "type": "bad",
              "popup": false
            },
            "else": {
              "if": {
                "and": [
                  "has_beta",
                  "npc_is_monster",
                  {
                    "math": [
                      "n_monsters_nearby('mon_berserk_godhand_femto', 'radius': 0, 'attitude': 'both') > 0"
                    ]
                  }
                ]
              },
              "then": {
                "u_message": "Фемто: Недостаточно.\n\nПять голосов умолкают. У начала тропы разрывается сомкнувшийся проход.",
                "type": "bad",
                "popup": false
