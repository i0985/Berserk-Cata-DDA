        "then": {
          "u_message": "Слан: Значит, вот как ты решил выразить своё желание. Что ж — посмотрим.\n\nПять голосов умолкают. У начала тропы разрывается сомкнувшийся проход.",
          "type": "bad",
          "popup": false
        },
        "else": {
          "if": {
