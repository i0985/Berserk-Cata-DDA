[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_SHADOW_HALLUCINATION",
    "//": "Keep this ID for recurring EOC compatibility with existing saves; it now spawns mixed waves.",
    "global": true,
    "recurrence": "30 seconds",
    "condition": {
      "and": [
        {
          "u_has_effect": "berserk_armor_active"
        },
        {
          "or": [
            {
              "u_has_effect": "berserk_curse_visions"
            },
            {
              "u_has_effect": "berserk_curse_brink"
            }
          ]
        }
      ]
    },
    "effect": [
      {
        "if": {
          "u_has_effect": "berserk_curse_brink"
        },
        "then": {
          "run_eocs": "EOC_BERSERK_SPAWN_ONE_SHADOW",
          "iterations": 3
        },
        "else": {
          "run_eocs": "EOC_BERSERK_SPAWN_ONE_SHADOW",
          "iterations": 2
        }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_SPAWN_ONE_SHADOW",
    "//": "Each iteration chooses a real shadow (2/3) or a hallucination (1/3) independently.",
    "effect": [
      {
        "if": {
