  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FIX25_FIRST_RETRY",
    "effect": [
      {
        "math": [
          "u_berserk_first_hunt_retry_at = time('now') + 3600"
        ]
      },
      {
        "math": [
          "u_berserk_first_hunt_search_attempts = 0"
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_FIRST_HUNT_REQUEST"
      }
    ],
    "condition": {
      "and": [
        {
          "and": [
            "u_is_avatar",
            {
              "math": [
                "berserk_eclipse_era == 1"
              ]
            },
            {
              "math": [
                "u_berserk_eclipse_rescue_state == 2"
              ]
            },
            {
              "math": [
                "u_val('pos_z') == 0"
              ]
            },
            {
              "not": {
                "math": [
                  "u_berserk_first_hunt_done == 1"
                ]
              }
            },
            {
              "test_eoc": "EOC_BERSERK_APOSTOL_HUMAN_ROUTE"
            }
          ]
        },
        {
          "not": {
            "and": [
              {
                "math": [
                  "has_var(u_berserk_first_hunt_location)"
                ]
              },
              {
                "overmap_at_point": "berserk_first_hunt_lair",
                "point": {
                  "u_val": "berserk_first_hunt_location"
                }
              }
            ]
          }
        },
        {
          "math": [
            "time('now') >= u_berserk_first_hunt_retry_at"
          ]
        }
      ]
    }
  },
