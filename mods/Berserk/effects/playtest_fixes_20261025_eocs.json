[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FIX25_HINT_CARAVAN",
    "effect": [
      {
        "u_location_variable": {
          "context_val": "berserk_hint_point"
        }
      },
      {
        "location_variable_adjust": {
          "context_val": "berserk_hint_point"
        },
        "overmap_tile": true
      },
      {
        "if": {
          "not": {
            "and": [
              {
                "math": [
                  "has_var(u_berserk_hint_caravan)"
                ]
              },
              {
                "math": [
                  "u_berserk_hint_caravan.x == _berserk_hint_point.x"
                ]
              },
              {
                "math": [
                  "u_berserk_hint_caravan.y == _berserk_hint_point.y"
                ]
              },
              {
                "math": [
                  "u_berserk_hint_caravan.z == _berserk_hint_point.z"
                ]
              }
            ]
          }
        },
        "then": [
          {
            "copy_var": {
              "context_val": "berserk_hint_point"
            },
            "target_var": {
              "u_val": "berserk_hint_caravan"
            }
          },
          {
            "u_message": "Supplies and a bundle of papers show beneath the broken wagon. You could approach the wreckage and examine what is still there.",
            "type": "info",
            "popup": true
          }
        ]
      }
    ],
    "condition": {
      "and": [
        "u_is_avatar",
        {
          "or": [
            {
              "u_at_om_location": "berserk_road_caravan"
            }
          ]
        }
      ]
    }
  },
