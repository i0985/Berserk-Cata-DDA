  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_COUNT_NOTICE",
    "effect": {
      "u_message": "The notices call fear order. The west prison holds the lists; the kitchen passage and broken western wall offer quieter approaches than the main yard. All lead toward the stairs in the northeastern hall.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_COUNT_FAMILY_DOOR",
    "effect": {
      "u_message": "The plate names Theresia. Bedding is folded, the sewing laid out, and none of the prison's chains were brought here. At the threshold, the marks of violence stop; beyond it, someone tried to keep a little ordinary life intact.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "ter_furn_transform",
    "id": "berserk_count_service_grate_opened",
    "furniture": [
      {
        "valid_furniture": [
          "f_berserk_count_service_grate"
        ],
        "result": "f_berserk_count_service_grate_open"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_COUNT_OPEN_GRATE",
    "condition": {
      "and": [
        {
          "math": [
            "distance('u', _pos) <= 1"
          ]
        },
        {
          "map_furniture_id": "f_berserk_count_service_grate",
          "loc": {
            "context_val": "pos"
          }
        }
      ]
    },
    "effect": {
      "if": {
        "u_has_item": "berserk_count_service_key"
      },
      "then": [
        {
          "if": {
            "u_query": "Open the service grille with the key?",
            "default": false
          },
          "then": [
            {
              "u_transform_radius": 0,
              "ter_furn_transform": "berserk_count_service_grate_opened",
              "target_var": {
                "context_val": "pos"
              }
            },
            {
              "u_message": "The service passage is open. It stays open; no key or tool is consumed.",
              "type": "info",
              "popup": false
            },
            {
              "turn_cost": "2 seconds"
            }
          ]
        }
      ],
      "else": {
        "if": {
          "or": [
            {
              "u_has_item": "hammer_sledge"
            },
            {
              "u_has_item": "hammer_sledge_short"
            }
          ]
        },
        "then": {
          "if": {
            "u_query": "Break the loose latch with your sledgehammer? Thirty seconds; the noise can attract enemies.",
            "default": false
          },
          "then": [
            {
              "u_transform_radius": 0,
              "ter_furn_transform": "berserk_count_service_grate_opened",
              "target_var": {
                "context_val": "pos"
              }
            },
            {
              "u_message": "The service passage is open. It stays open; no key or tool is consumed.",
              "type": "info",
              "popup": false
            },
            {
              "turn_cost": "30 seconds"
            },
            {
              "u_make_sound": "Iron rings against the stone passage.",
              "volume": 20,
              "type": "activity",
              "target_var": {
                "context_val": "pos"
              }
            }
          ]
        },
        "else": {
          "u_message": "The prison clerk kept a key; a long or short sledgehammer can also break this latch. Use the open courtyard or the kitchen route if you lack both.",
          "type": "info",
          "popup": false
        }
      }
    }
  },
