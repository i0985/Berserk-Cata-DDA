[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_COUNT_PRISON_LIST_READ",
    "effect": {
      "u_message": "Names repeat on the execution notices. Shoes and cloaks were sorted before the sentence, as though the owner had already ceased to be a person. One entry was crossed out and replaced by 'sent below'. There is no altar here: terror was an ordinary office routine.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_COUNT_PHYSICIAN_LEDGER_READ",
    "effect": {
      "u_message": "The early pages discuss boiled linen and ordinary wounds. Later sketches show an extra mouth growing through a servant's chest. The writer stopped calling it an illness: fragments of the master's flesh were forcing a second life into the victim. His treatment could not reverse it. The servants are finite, not a renewing garrison.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_COUNT_FAMILY_RIBBON_READ",
    "effect": {
      "u_message": "The ribbon lay beside sewing and a book kept clear of dust. A note calls the room Theresia's and orders the servants not to disturb it. The same ruler who signed the prison lists protected this little island of ordinary life. Her whereabouts are not recorded; the servants kept this door closed as the rest of the house fell apart.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_COUNT_NEXT_TRACE_READ",
    "effect": [
      {
        "u_message": "These are separate trails: Black Dogs on one route, a mist-filled valley on another. The Count's death does not close those wounds. After the battle, consult the hunt journal to choose a destination; each place keeps its own result.",
        "type": "info",
        "popup": true
      },
      {
        "if": {
          "math": [
            "berserk_hunt_count_state >= 3"
          ]
        },
        "then": [
          {
            "run_eocs": "EOC_BERSERK_HUNT_GIVE_JOURNAL"
          },
          {
            "if": {
              "u_query": "Consult the independent hunt routes now?",
              "default": false
            },
            "then": {
              "run_eocs": "EOC_BERSERK_HUNT_JOURNAL_USE"
            }
          }
        ]
      }
    ]
  },
