[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ROAD_READ_CARAVAN",
    "effect": [
      {
        "u_message": "Колесо сломалось до сумерек. Железные крепления оставили под окованным коробом, зерно унесли.\n\nМежду страницами вложен заказ: «Отнести погнутые клинки в лесную кузницу Годо. С ним работает молодой мастер арбалетов. Держаться старых тележных троп через лес».\n\nНа полях отмечены повороты и переправы.",
        "type": "info",
        "popup": true
      },
      {
        "if": {
          "not": {
            "math": [
              "u_berserk_journal_read_berserk_road_caravan_note == 1"
            ]
          }
        },
        "then": [
          {
            "math": [
              "u_berserk_journal_read_berserk_road_caravan_note = 1"
            ]
          },
          {
            "run_eocs": "EOC_BERSERK_GODO_LEARN_TRACE"
          },
          {
            "run_eocs": "EOC_BERSERK_GODO_ROUTE_MISSION"
          },
          {
            "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
          }
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_REF_SYNC"
      }
    ],
    "//": "Reference journal: physical source only; rereading never reapplies progression."
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ROAD_READ_SCOUT",
    "effect": [
      {
        "u_message": "За открытой поляной следят. Я видел, как деревья двигались в безветрие. Привязал ранец над промоиной и пошёл нижней тропой — проверить другой берег. Если не вернусь, держитесь камня и оставляйте место, чтобы повернуть назад.",
        "type": "info",
        "popup": true
      },
      {
        "if": {
          "not": {
            "math": [
              "u_berserk_journal_read_berserk_road_scout_note == 1"
            ]
          }
        },
        "then": [
          {
            "math": [
              "u_berserk_journal_read_berserk_road_scout_note = 1"
            ]
          },
          {
            "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
          }
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_REF_SYNC"
      }
    ],
    "//": "Reference journal: physical source only; rereading never reapplies progression."
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ROAD_READ_CAMP",
    "effect": [
      {
        "u_message": "Уходим до следующих сумерек. Вода чистая; тем, кто пойдёт следом, одеяло может понадобиться больше, чем нам.\n\nКузнец Годо починил наш сломанный клинок. Его молодой помощник делает арбалетные болты. Здесь записали обратную дорогу: старая тропа, переправа через ручей, затем путь углежогов. Идти долго, но в конце дороги есть мастер.",
        "type": "info",
        "popup": true
      },
      {
        "if": {
          "not": {
            "math": [
              "u_berserk_journal_read_berserk_road_camp_note == 1"
            ]
          }
        },
        "then": [
          {
            "math": [
              "u_berserk_journal_read_berserk_road_camp_note = 1"
            ]
          },
          {
            "run_eocs": "EOC_BERSERK_GODO_LEARN_TRACE"
          },
          {
            "run_eocs": "EOC_BERSERK_GODO_ROUTE_MISSION"
          },
          {
            "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
          }
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_REF_SYNC"
      }
    ],
    "//": "Reference journal: physical source only; rereading never reapplies progression."
  },
