[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ROAD_READ_CARAVAN",
    "effect": {
      "if": {
        "math": [
          "u_berserk_journal_read_berserk_road_caravan_note == 1"
        ]
      },
      "then": [
        {
          "run_eocs": "EOC_BERSERK_JOURNAL_LEARN_GODO"
        },
        {
          "open_dialogue": {
            "topic": "TALK_BERSERK_JOURNAL_RECORD_BERSERK_ROAD_CARAVAN_NOTE"
          }
        }
      ],
      "else": [
        {
          "u_message": "The wheel broke before dusk. We left the iron fittings under the bound box and carried the grain away. A repair order is tucked between the pages: \"Take the bent blades to Godot’s woodland forge. He works with a young crossbow maker. Keep to the old cart tracks through the woods.\" The margins record bends and stream crossings.",
          "type": "info",
          "popup": true
        },
        {
          "run_eocs": "EOC_BERSERK_GODO_LEARN_TRACE"
        },
        {
          "math": [
            "u_berserk_journal_read_berserk_road_caravan_note = 1"
          ]
        },
        {
          "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
        },
        {
          "run_eocs": "EOC_BERSERK_GODO_ROUTE_MISSION"
        }
      ]
    },
    "//": "Road journal archive: berserk_road_caravan_note"
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ROAD_READ_SCOUT",
    "effect": {
      "if": {
        "math": [
          "u_berserk_journal_read_berserk_road_scout_note == 1"
        ]
      },
      "then": {
        "open_dialogue": {
          "topic": "TALK_BERSERK_JOURNAL_RECORD_BERSERK_ROAD_SCOUT_NOTE"
        }
      },
      "else": [
        {
          "u_message": "The open clearing is watched. I saw the trees move while the air was still. I tied the pack above the washout and took the lower path to see whether the other bank was clear. If I fail to return, keep to stone and leave room to turn back.",
          "popup": true,
          "type": "info"
        },
        {
          "math": [
            "u_berserk_journal_read_berserk_road_scout_note = 1"
          ]
        },
        {
          "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
        },
        {
          "u_message": "A new entry has been added to your road journal.",
          "type": "info",
          "popup": false
        }
      ]
    },
    "//": "Road journal archive: berserk_road_scout_note"
  },
  {
