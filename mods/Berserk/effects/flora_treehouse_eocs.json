  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_MANUSCRIPT",
    "effect": [
      {
        "if": {
          "and": [
            {
              "math": [
                "berserk_flora_siege_state >= 2"
              ]
            },
            {
              "math": [
                "berserk_flora_siege_state <= 4"
              ]
            }
          ]
        },
        "then": {
          "if": {
            "u_query": "Rescue the unfinished manuscript? It costs time; escaping without it still succeeds.",
            "default": false
          },
          "then": [
            {
              "u_transform_radius": 0,
              "ter_furn_transform": "berserk_flora_manuscript_taken",
              "target_var": {
                "context_val": "pos"
              }
            },
            {
              "if": {
                "map_furniture_id": "f_berserk_flora_manuscript_taken",
                "loc": {
                  "context_val": "pos"
                }
              },
              "then": [
                {
                  "map_spawn_item": "berserk_flora_rescued_manuscript",
                  "loc": {
                    "context_val": "pos"
                  }
                },
                {
                  "math": [
                    "berserk_flora_manuscript_rescued = 1"
                  ]
                },
                {
                  "u_message": "The manuscript lies here ready to be picked up. Leave by the western road or southern garden; do not wait for a victory.",
                  "type": "info",
                  "popup": false
                },
                {
                  "turn_cost": "2 seconds"
                }
              ]
            }
          ]
        },
        "else": {
          "u_message": "These unfinished pages gather Flora's notes on paths between worlds. A smooth stone holds down the loose sheets; careful annotations crowd the margins. Beside them lies a quill she has not yet cleaned.",
          "type": "info",
          "popup": true
        }
      },
      {
        "if": {
          "map_furniture_id": "f_berserk_flora_manuscript",
          "loc": {
            "context_val": "pos"
          }
        },
        "then": {
          "math": [
            "u_berserk_flora33_manuscript_seen = 1"
          ]
        }
      }
    ],
    "condition": {
      "and": [
        {
          "test_eoc": "EOC_BERSERK_FLORA_AT_REGISTERED_MANOR"
        },
        {
          "math": [
            "distance('u', _pos) <= 1"
          ]
        },
        {
          "map_furniture_id": "f_berserk_flora_manuscript",
          "loc": {
            "context_val": "pos"
          }
        }
      ]
    }
  },
