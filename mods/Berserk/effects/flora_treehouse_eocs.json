  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_TREEHOUSE_REGISTER",
    "effect": [
      {
        "copy_var": {
          "global_val": "berserk_flora_location"
        },
        "target_var": {
          "context_val": "flora_layout"
        }
      },
      {
        "location_variable_adjust": {
          "context_val": "flora_layout"
        },
        "x_adjust": 14,
        "y_adjust": 12
      },
      {
        "if": {
          "map_furniture_id": "f_berserk_flora_treehouse_threshold_v2",
          "loc": {
            "context_val": "flora_layout"
          }
        },
        "then": {
          "math": [
            "berserk_flora_treehouse_layout = 2"
          ]
        },
        "else": {
          "if": {
            "map_furniture_id": "f_berserk_flora_treehouse_threshold",
            "loc": {
              "context_val": "flora_layout"
            }
          },
          "then": {
            "math": [
              "berserk_flora_treehouse_layout = 1"
            ]
          }
        }
      }
    ],
    "condition": {
      "test_eoc": "EOC_BERSERK_FLORA_AT_REGISTERED_MANOR"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_CLAIM_GIFT",
    "condition": {
      "and": [
        {
          "math": [
            "distance('u', _pos) <= 1"
          ]
        },
        {
          "map_furniture_id": {
            "context_val": "berserk_location_full"
          },
          "loc": {
            "context_val": "pos"
          }
        }
      ]
    },
    "false_effect": {
      "u_message": "Nothing could be recovered here.",
      "type": "info"
    },
    "effect": {
      "if": {
        "u_query": "Take Flora's offered bundle?",
        "default": false
      },
      "then": [
        {
          "u_transform_radius": 0,
          "ter_furn_transform": {
            "context_val": "berserk_location_transform"
          },
          "target_var": {
            "context_val": "pos"
          }
        },
        {
          "if": {
            "map_furniture_id": {
              "context_val": "berserk_location_empty"
            },
            "loc": {
              "context_val": "pos"
            }
          },
          "then": [
            {
              "map_spawn_item": {
                "context_val": "berserk_location_loot"
              },
              "use_item_group": true,
              "loc": {
                "context_val": "pos"
              }
            },
            {
              "u_message": "You lay the recovered belongings here. Pick them up before leaving.",
              "type": "info"
            }
          ],
          "else": {
            "u_message": "Nothing could be recovered here.",
            "type": "info"
          }
        }
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_SANCTUARY_WARD",
    "effect": {
      "u_message": "The pale stones quiet the Brand's call while the grove is peaceful. New night pursuers and nearby manifestations are held back, but the mark remains. Enemies already inside the grove and the armor's shadows still threaten you. The tree offers a place to prepare, not invulnerability.",
      "type": "info",
      "popup": true
    }
  }
]
