              ]
            }
          ]
        },
        {
          "math": [
            "berserk_flora_aid_authorized != 1"
          ]
        }
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_TRAVEL_FOLIO",
    "effect": [
      {
        "u_message": "Clean cloth for dressings must be boiled. A waterskin is best sewn before a long journey. Drinking water, a sleeping place and a clear exit matter more than a comfortable room.\n\nA small sign of stone and bone helps restrain the nighttime call, but does not drive away a creature already standing at the door.",
        "type": "info",
        "popup": true
      },
      {
        "if": {
          "not": {
            "math": [
              "u_berserk_journal_read_berserk_flora_travel_folio == 1"
            ]
          }
        },
        "then": [
          {
            "math": [
              "u_berserk_journal_read_berserk_flora_travel_folio = 1"
            ]
          },
          {
            "u_learn_recipe": "bandages_makeshift_boiled"
          },
          {
            "u_learn_recipe": "waterskin"
          },
          {
            "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
          }
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_REF_SYNC"
      }
    ],
    "//": "Reference journal: physical source only; rereading never reapplies progression."
  },
