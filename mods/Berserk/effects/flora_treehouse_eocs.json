    "id": "EOC_BERSERK_FLORA_READ_CHARRED_ARCHIVE",
    "effect": {
      "u_message": "The edges of the pages are curled and blackened, crumbling at a touch. A few surviving lines can still be read between the charred edges: fragments of phrases without beginning or end. The fire took the rest completely. Nothing can bring it back.",
      "type": "info",
      "popup": true
