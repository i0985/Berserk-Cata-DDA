        "berserk_location_full": "f_berserk_flora_aid_pantry",
        "berserk_location_empty": "f_berserk_flora_aid_pantry_empty",
        "berserk_location_transform": "berserk_flora_aid_pantry_claimed",
        "berserk_location_loot": "berserk_flora_aid_pantry"
      }
    },
    "condition": {
