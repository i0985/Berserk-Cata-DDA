  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_CHARRED_ARCHIVE",
    "effect": {
      "u_message": "The unfinished pages burned with the house. Your escape was still a success; the remaining hunts can be followed through your journal.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_SAVED_ARCHIVE",
    "effect": {
      "u_message": "The desk is lost, but the manuscript was taken out. The saved work cannot restore the sanctuary; it preserves something of the person who sheltered you.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "ter_furn_transform",
    "id": "berserk_flora_manuscript_taken",
    "furniture": [
      {
        "valid_furniture": [
          "f_berserk_flora_manuscript"
        ],
        "result": "f_berserk_flora_manuscript_taken"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_MANUSCRIPT",
    "effect": {
      "if": {
        "and": [
          {
            "math": [
              "berserk_flora_siege_state >= 2"
            ]
          },
          {
            "math": [
              "berserk_flora_siege_state <= 4"
            ]
          }
        ]
      },
      "then": {
        "if": {
          "u_query": "Rescue the unfinished manuscript? It costs time; escaping without it still succeeds.",
          "default": false
        },
        "then": [
          {
            "u_transform_radius": 0,
            "ter_furn_transform": "berserk_flora_manuscript_taken",
            "target_var": {
              "context_val": "pos"
            }
          },
          {
            "if": {
              "map_furniture_id": "f_berserk_flora_manuscript_taken",
              "loc": {
                "context_val": "pos"
              }
            },
            "then": [
              {
                "map_spawn_item": "berserk_flora_rescued_manuscript",
                "loc": {
                  "context_val": "pos"
                }
              },
              {
                "math": [
                  "berserk_flora_manuscript_rescued = 1"
                ]
              },
              {
                "u_message": "The manuscript lies here ready to be picked up. Leave by the western road or southern garden; do not wait for a victory.",
                "type": "info",
                "popup": true
              },
              {
                "turn_cost": "2 seconds"
              }
            ]
          }
        ]
      },
      "else": {
        "u_message": "These unfinished pages gather Flora's notes on paths between worlds. A smooth stone holds down the loose sheets; careful annotations crowd the margins. Beside them lies a quill she has not yet cleaned.",
        "type": "info",
        "popup": true
      }
    },
    "condition": {
      "and": [
        {
          "test_eoc": "EOC_BERSERK_FLORA_AT_REGISTERED_MANOR"
        },
        {
          "math": [
            "distance('u', _pos) <= 1"
          ]
        },
        {
          "map_furniture_id": "f_berserk_flora_manuscript",
          "loc": {
            "context_val": "pos"
          }
        }
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_RESCUED_MANUSCRIPT",
    "effect": {
      "u_message": "The pages survived because someone chose to carry them. Flora compares the joined worlds to roots grafted across a wound. A quiet place can shelter a traveler; no single refuge can mend the whole world. These notes grant no combat power.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_BOOKMARK",
    "effect": [
      {
        "u_message": "A leaf-shaped wooden bookmark survived inside the stone-lined root niche. Its little inscription reads: leave a light for the next traveler. The house will not return, and its attack cannot be repeated. Your hunt journal still gives the next roads.",
        "type": "info",
        "popup": true
      },
      {
        "run_eocs": "EOC_BERSERK_FLORA_PROGRESS_REPORT"
      }
    ]
  },
