[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_TREEHOUSE_THRESHOLD",
    "effect": {
      "u_message": "A small welcome is woven into the mat: \"Come in from the road. There is a place by the hearth and a bed beyond the guest passage. Leave a light for whoever follows.\"",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_GUEST_RECORD",
    "effect": {
      "u_message": "\"Fresh linen is in the cupboard. The kitchen is across the root gallery; drinking water has been prepared there. If the night troubles you, rest beneath the tree before returning to the road.\"",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_HOUSE_RULES",
    "effect": {
      "u_message": "\"The books are here to be read, not carried away. Ask me for food, mending supplies or materials for a protective sign; bundles are ready in the pantry and workshop. If you seek the armor, we must speak of its price first.\"",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_COSMOLOGY_SHELF",
    "effect": {
      "u_message": "The books distinguish the God Hand from apostles and projections. The collision with this world deepened local wounds; quieting one breach cannot close them all.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_WARD_SHELF",
    "effect": {
      "u_message": "A small stone and bone ward quiets new night summons of the Brand within eight tiles. It does not stop zombies or drive away demons already present. Build it in a defensible shelter, not as a substitute for walls.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_CHRONICLE_SHELF",
    "effect": {
      "u_message": "These pages remember someone keeping the lamps lit, repairing a sleeve and preparing a bed for a stranger. The sanctuary was a home before it became a refuge.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_BOTANY_SHELF",
    "effect": {
      "u_message": "Keep drinking water clean. Boil cloth before dressing a wound. Rest does not restore a missing hand or an eye. The kitchen and garden offer care, not a cure for sacrifice.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_GALLERY_RECORD",
    "effect": {
      "u_message": "A faded drawing traces the house around the great trunk. Books and the hearth occupy the western wing, the kitchen faces east, and the workshop opens onto the herb garden. Two small beds are drawn beyond the western guest passage.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_GARDEN_RECORD",
    "effect": {
      "u_message": "Labels name the plants and the seasons when they should be gathered. The covered basin stands near the southern beds. Between the benches a wicket has been tied open, leading to the woodland path.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_WEST_SIGN",
    "effect": {
      "u_message": "A carved arrow points west: \"Woodland road.\" The path winds between old trees and disappears behind the grove.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_SOUTH_SIGN",
    "effect": {
      "u_message": "A wooden marker reads: \"Herb garden.\" Beyond the beds, a gate opens onto a footpath running south.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_ARMOR_STAND",
    "effect": {
      "u_message": "Leather pads cover the wooden stand. Nearby fitting notes show where the plates bear on a wearer and where straps must leave room to move. The armor is no common suit to take from a rack; Flora must entrust it to you.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_ROOT_NICHE",
    "effect": {
      "u_message": "A leaf-shaped carving has been tucked into a stone-lined hollow under the roots. It belongs to this house; nothing here has been set aside for a visitor.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_ALLOW_AID",
    "effect": [
      {
        "math": [
          "berserk_flora_aid_authorized = 1"
        ]
      },
      {
        "if": {
          "math": [
            "berserk_flora_folio_given != 1"
          ]
        },
        "then": [
          {
            "u_spawn_item": "berserk_flora_travel_folio",
            "count": 1
          },
          {
            "math": [
              "berserk_flora_folio_given = 1"
            ]
          }
        ]
      },
      {
        "u_message": "Flora offers the prepared bundles in the kitchen, workshop and southern gallery, and gives you her travel notes.",
        "type": "info",
        "popup": false
      }
    ],
    "condition": {
      "and": [
        "has_beta",
        "npc_is_monster",
        {
          "math": [
            "n_monsters_nearby('mon_berserk_flora', 'radius': 0, 'attitude': 'both') > 0"
          ]
        },
        {
          "math": [
            "berserk_flora_stage == 1"
          ]
        }
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_READ_TRAVEL_FOLIO",
    "effect": [
      {
        "u_learn_recipe": "bandages_makeshift_boiled"
      },
      {
        "u_learn_recipe": "waterskin"
      },
      {
        "u_message": "Flora's notes: boil clean cloth for dressings; sew a waterskin before a long journey. A defensible room, drinking water, a bed and a small stone-and-bone ward make a refuge. The ward quiets new Brand summons within eight tiles, not existing enemies. Neither the missing hand nor eye will grow back through rest.",
        "type": "info",
        "popup": true
      }
    ]
  },
  {
    "type": "ter_furn_transform",
    "id": "berserk_flora_aid_pantry_claimed",
    "furniture": [
      {
        "valid_furniture": [
          "f_berserk_flora_aid_pantry"
        ],
        "result": "f_berserk_flora_aid_pantry_empty"
      }
    ]
  },
  {
