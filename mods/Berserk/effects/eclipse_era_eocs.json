[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_ERA_ENTER_OMT",
    "eoc_type": "EVENT",
    "required_event": "avatar_enters_omt",
    "condition": {
      "and": [
        { "math": [ "berserk_eclipse_era == 1" ] },
        { "math": [ "u_val('pos_z') == 0" ] },
        { "math": [ "u_berserk_eclipse_trial_active != 1" ] }
      ]
    },
    "effect": [
      {
        "set_string_var": "g_berserk_eclipse_era_omt_v2_<context_val:pos>",
        "target_var": { "context_val": "berserk_era_omt_key" },
        "parse_tags": true
      },
      {
        "if": { "not": { "compare_string": [ "1", { "var_val": "berserk_era_omt_key" } ] } },
        "then": [
          { "set_string_var": "1", "target_var": { "var_val": "berserk_era_omt_key" } },
          { "run_eocs": "EOC_BERSERK_ECLIPSE_ERA_COUNT_NEARBY" },
          { "u_location_variable": { "context_val": "berserk_era_loc" } },
          {
            "if": { "map_in_city": { "context_val": "berserk_era_loc" } },
            "then": [
              { "run_eocs": "EOC_BERSERK_ECLIPSE_ERA_COUNT_ZOMBIES" },
              { "run_eocs": "EOC_BERSERK_ECLIPSE_ERA_CITY_ENCOUNTER" }
            ],
            "else": {
              "if": {
                "and": [
                  { "math": [ "berserk_era_nearby_count < 4" ] },
                  { "x_in_y_chance": { "x": 1, "y": 15 } }
                ]
              },
              "then": { "run_eocs": "EOC_BERSERK_ECLIPSE_ERA_WILDS_ENCOUNTER" }
            }
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_ERA_COUNT_NEARBY",
    "effect": [
      { "math": [ "berserk_era_nearby_count = 0" ] },
      {
        "u_run_monster_eocs": [
          {
            "id": "EOC_BERSERK_ECLIPSE_ERA_COUNT_ONE",
            "effect": { "math": [ "berserk_era_nearby_count += 1" ] }
          }
        ],
        "mtype_ids": [
          "mon_berserk_eclipse_wretch",
          "mon_berserk_eclipse_halfbreed",
          "mon_berserk_eclipse_hunter",
          "mon_berserk_eclipse_butcher",
          "mon_berserk_eclipse_elite",
          "mon_berserk_eclipse_griffith",
          "mon_void_apostle",
          "mon_nosferatu_zodd",
          "mon_griffith_reborn",
          "mon_beast_of_darkness_1",
          "mon_beast_of_darkness_2",
          "mon_beast_of_darkness_3",
          "mon_beast_of_darkness_4",
          "mon_beast_of_darkness_5",
          "mon_beast_of_darkness_6"
        ],
        "monster_range": 24
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_ERA_COUNT_ZOMBIES",
    "effect": [
      { "math": [ "berserk_era_zombie_count = 0" ] },
      {
        "u_run_monster_eocs": [
          {
            "id": "EOC_BERSERK_ECLIPSE_ERA_COUNT_ZOMBIE",
            "condition": { "u_has_species": "ZOMBIE" },
            "effect": { "math": [ "berserk_era_zombie_count += 1" ] }
          }
        ],
        "monster_range": 24
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_ERA_CITY_ENCOUNTER",
    "condition": {
      "and": [
        { "math": [ "berserk_era_zombie_count >= 5" ] },
        { "math": [ "berserk_era_nearby_count < min(24, floor(berserk_era_zombie_count / 5))" ] }
      ]
    },
    "effect": {
      "u_spawn_monster": "GROUP_BERSERK_ECLIPSE_ERA_CITY",
      "group": true,
      "real_count": { "math": [ "min(4, min(24, floor(berserk_era_zombie_count / 5)) - berserk_era_nearby_count)" ] },
      "min_radius": 8,
      "max_radius": 14
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_ERA_WILDS_ENCOUNTER",
    "effect": {
      "u_spawn_monster": "GROUP_BERSERK_ECLIPSE_ERA_WILDS",
      "group": true,
      "single_target": true,
      "real_count": 1,
      "min_radius": 8,
      "max_radius": 14,
      "outdoor_only": true
    }
  }
]
