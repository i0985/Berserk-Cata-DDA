            "effect": [
              {
                "math": [
                  "berserk_era_nearby_count += 1"
                ]
              },
              {
                "if": {
                  "or": [
                    {
                      "compare_string": [
                        "brand",
                        {
                          "u_val": "berserk_spawn_source"
                        }
                      ]
                    },
                    {
                      "math": [
                        "u_monsters_nearby('mon_berserk_brand_wretch', 'mon_berserk_brand_halfbreed', 'mon_berserk_brand_hunter', 'mon_berserk_brand_butcher', 'radius': 0) > 0"
                      ]
                    }
                  ]
                },
                "then": {
                  "math": [
                    "berserk_spawn_brand_nearby += 1"
                  ]
                },
                "else": {
                  "if": {
                    "or": [
                      {
                        "compare_string": [
                          "armor",
                          {
                            "u_val": "berserk_spawn_source"
                          }
                        ]
                      },
                      {
                        "math": [
                          "u_monsters_nearby('mon_beast_of_darkness_1', 'mon_beast_of_darkness_2', 'mon_beast_of_darkness_3', 'mon_beast_of_darkness_4', 'mon_beast_of_darkness_5', 'mon_beast_of_darkness_6', 'radius': 0) > 0"
                        ]
                      }
                    ]
                  },
                  "then": {
                    "math": [
                      "berserk_spawn_armor_nearby += 1"
                    ]
                  },
                  "else": {
                    "math": [
                      "berserk_spawn_world_or_site_nearby += 1"
                    ]
                  }
                }
              }
            ],
            "condition": {
              "math": [
                "u_hp('ALL') > 0"
              ]
            }
          }
        ],
