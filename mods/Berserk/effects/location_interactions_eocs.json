  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_READ_OAK_LAST_NOTE",
    "effect": [
      {
        "u_message": "We left the cart on the old path. The face is caught in the roots, just as he said. While the creature circled the trunk, I waited behind the thick roots and didn't move.\n\nWe'll return by the old western path. If only one of us reaches the cart, leave the other's name on the cord.",
        "type": "info",
        "popup": true
      },
      {
        "if": {
          "not": {
            "math": [
              "u_berserk_journal_read_berserk_oak_last_note == 1"
            ]
          }
        },
        "then": [
          {
            "math": [
              "u_berserk_journal_read_berserk_oak_last_note = 1"
            ]
          },
          {
            "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
          }
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_REF_SYNC"
      }
