[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_READ_OAK_BROKEN_ROOTCUTTER",
    "effect": {
      "u_message": "Fresh cuts stop halfway through the roots. Two sets of tally marks were scratched into the haft; one ends abruptly. They meant to cut a path to the stone face, not to fight what lived beneath it.",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_READ_OAK_WAYFARER_WARD",
    "effect": {
      "u_message": "The inscription names two travelers and asks that both return home. A second knot was added with a shaking hand. Beyond it, the bark bears the same dark stain as the abandoned cutting tool.",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_READ_OAK_LAST_NOTE",
    "effect": {
      "u_message": "We left the cart on the old track. The face is caught in the roots, just as he said. At the eastern edge, the bones rang and the thing beneath the trunk turned toward them. I waited behind the thick roots until it passed. We will return by the old western track. If only one of us reaches the cart, leave the other name on the cord.",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_LOCATION_SEARCHED",
    "effect": {
      "u_message": "Only scraps of the old wrapping remain.",
      "type": "info"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_LOCATION_CLAIM",
    "condition": {
      "and": [
        {
          "math": [
            "distance('u', _pos) <= 1"
          ]
        },
        {
          "map_furniture_id": {
            "context_val": "berserk_location_full"
          },
          "loc": {
            "context_val": "pos"
          }
        }
      ]
    },
    "false_effect": {
      "u_message": "Nothing could be recovered here.",
      "type": "info"
    },
    "effect": {
      "if": {
        "u_query": "Collect the abandoned belongings?",
        "default": false
      },
      "then": [
        {
          "u_transform_radius": 0,
          "ter_furn_transform": {
            "context_val": "berserk_location_transform"
          },
          "target_var": {
            "context_val": "pos"
          }
        },
        {
          "if": {
            "map_furniture_id": {
              "context_val": "berserk_location_empty"
            },
            "loc": {
              "context_val": "pos"
            }
          },
          "then": [
            {
              "map_spawn_item": {
                "context_val": "berserk_location_loot"
              },
              "use_item_group": true,
              "loc": {
                "context_val": "pos"
              }
            },
            {
              "u_message": "You lay the recovered belongings here. Pick them up before leaving.",
              "type": "info"
            }
          ],
          "else": {
            "u_message": "Nothing could be recovered here.",
            "type": "info"
          }
        }
      ]
    }
  },
