[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_READ_OAK_BROKEN_ROOTCUTTER",
    "effect": [
      {
        "u_message": "Fresh cuts stop halfway through the roots. Two sets of tally marks were scratched into the haft; one ends abruptly. They meant to cut a path to the stone face, not to fight what lived beneath it.",
        "type": "info",
        "popup": true
      },
      {
        "if": {
          "not": {
            "math": [
              "u_berserk_journal_read_berserk_oak_broken_rootcutter == 1"
            ]
          }
        },
        "then": [
          {
            "math": [
              "u_berserk_journal_read_berserk_oak_broken_rootcutter = 1"
            ]
          },
          {
            "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
          }
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_REF_SYNC"
      }
    ],
    "//": "Reference journal: physical source only; rereading never reapplies progression."
  },
