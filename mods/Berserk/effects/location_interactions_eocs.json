[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_READ_OAK_BROKEN_ROOTCUTTER",
    "effect": [
      {
        "u_message": "Свежие зарубки обрываются посреди корней. На древке вырезаны два ряда отметок; один внезапно заканчивается. Эти люди пытались прорубить путь к каменному лицу, а не сразиться с тем, что жило под ним.",
        "type": "info",
        "popup": true
      },
      {
        "if": {
          "not": {
            "math": [
              "u_berserk_journal_read_berserk_oak_broken_rootcutter == 1"
            ]
          }
        },
        "then": [
          {
            "math": [
              "u_berserk_journal_read_berserk_oak_broken_rootcutter = 1"
            ]
          },
          {
            "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
          }
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_REF_SYNC"
      }
    ],
    "//": "Reference journal: physical source only; rereading never reapplies progression."
  },
