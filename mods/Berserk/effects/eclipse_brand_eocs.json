[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_INSTALL_MARKS",
    "effect": [
      {
        "if": { "not": { "u_has_bionics": "bio_berserk_brand_of_sacrifice" } },
        "then": { "u_add_bionic": "bio_berserk_brand_of_sacrifice" }
      },
      {
        "if": { "not": { "u_has_bionics": "bio_berserk_lost_eye" } },
        "then": { "u_add_bionic": "bio_berserk_lost_eye" }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_RESTORE_OLD_SAVE_MARKS",
    "global": true,
    "recurrence": "1 minute",
    "condition": {
      "and": [
        { "math": [ "berserk_eclipse_era == 1" ] },
        { "math": [ "u_berserk_eclipse_rescue_state == 2" ] },
        {
          "or": [
            { "not": { "u_has_bionics": "bio_berserk_brand_of_sacrifice" } },
            { "not": { "u_has_bionics": "bio_berserk_lost_eye" } }
          ]
        }
      ]
    },
    "effect": { "run_eocs": "EOC_BERSERK_ECLIPSE_INSTALL_MARKS" }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_NIGHT_HUNT",
    "global": true,
    "recurrence": "1 hour",
    "condition": {
      "and": [
        { "u_has_bionics": "bio_berserk_brand_of_sacrifice" },
        { "math": [ "berserk_eclipse_era == 1" ] },
        { "math": [ "u_val('pos_z') == 0" ] },
        { "math": [ "u_berserk_eclipse_trial_active != 1" ] },
        { "not": "is_day" }
      ]
    },
    "effect": {
      "u_location_variable": { "context_val": "berserk_near_shelter_ward" },
      "furniture": "f_berserk_shelter_ward",
      "target_max_radius": 8,
      "false_eocs": [ "EOC_BERSERK_BRAND_NIGHT_HUNT_UNSHELTERED" ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_NIGHT_HUNT_UNSHELTERED",
    "effect": [
      { "run_eocs": "EOC_BERSERK_ECLIPSE_ERA_COUNT_NEARBY" },
      {
        "if": { "math": [ "berserk_era_nearby_count < 8" ] },
        "then": {
          "u_spawn_monster": "GROUP_BERSERK_ECLIPSE_ERA_CITY",
          "group": true,
          "single_target": true,
          "real_count": 1,
          "min_radius": 20,
          "max_radius": 30,
          "outdoor_only": true,
          "true_eocs": [ "EOC_BERSERK_BRAND_DEMON_ARRIVAL" ]
        }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_DEMON_ARRIVAL",
    "effect": { "run_eocs": "EOC_BERSERK_BRAND_ORDINARY_WARNING" }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_DEMON_SCAN",
    "global": true,
    "recurrence": "1 minute",
    "condition": { "u_has_bionics": "bio_berserk_brand_of_sacrifice" },
    "effect": {
      "u_run_monster_eocs": [ "EOC_BERSERK_BRAND_REPORT_DEMON" ],
      "mtype_ids": [
        "mon_berserk_eclipse_wretch",
        "mon_berserk_eclipse_halfbreed",
        "mon_berserk_eclipse_hunter",
        "mon_beast_of_darkness_1",
        "mon_beast_of_darkness_2",
        "mon_beast_of_darkness_3",
        "mon_beast_of_darkness_4",
        "mon_beast_of_darkness_5",
        "mon_beast_of_darkness_6"
      ],
      "monster_range": 24
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_REPORT_DEMON",
    "effect": { "run_eocs": "EOC_BERSERK_BRAND_ORDINARY_WARNING", "alpha_talker": "avatar" }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_ORDINARY_WARNING",
    "condition": {
      "and": [
        { "u_has_bionics": "bio_berserk_brand_of_sacrifice" },
        { "not": { "u_has_effect": "berserk_brand_demon_cooldown" } }
      ]
    },
    "effect": [
      { "u_add_effect": "berserk_brand_demon_cooldown", "duration": "8 minutes" },
      {
        "if": { "math": [ "u_pain() < 10" ] },
        "then": { "math": [ "u_pain() = min(10, u_pain() + 2)" ] }
      },
      { "u_message": "The Brand of Sacrifice stings. Demons are gathering nearby.", "type": "warning" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_POWERFUL_SCAN",
    "global": true,
    "recurrence": "30 seconds",
    "condition": { "u_has_bionics": "bio_berserk_brand_of_sacrifice" },
    "effect": {
      "u_run_monster_eocs": [ "EOC_BERSERK_BRAND_REPORT_POWERFUL" ],
      "mtype_ids": [
        "mon_void_apostle",
        "mon_nosferatu_zodd",
        "mon_griffith_reborn",
        "mon_berserk_projection_zodd",
        "mon_berserk_projection_griffith",
        "mon_berserk_projection_void",
        "mon_berserk_eclipse_griffith",
        "mon_berserk_eclipse_butcher",
        "mon_berserk_eclipse_elite"
      ],
      "monster_range": 40
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_REPORT_POWERFUL",
    "effect": { "run_eocs": "EOC_BERSERK_BRAND_POWERFUL_WARNING", "alpha_talker": "avatar" }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_POWERFUL_WARNING",
    "condition": {
      "and": [
        { "u_has_bionics": "bio_berserk_brand_of_sacrifice" },
        { "not": { "u_has_effect": "berserk_brand_powerful_cooldown" } }
      ]
    },
    "effect": [
      { "u_add_effect": "berserk_brand_powerful_cooldown", "duration": "5 minutes" },
      {
        "if": { "math": [ "u_pain() < 10" ] },
        "then": { "math": [ "u_pain() = min(10, u_pain() + 2)" ] }
      },
      { "u_message": "The Brand of Sacrifice burns. A terrifying presence is somewhere nearby.", "type": "warning" }
    ]
  }
]
