        "then": {
          "math": [
            "u_pain() = min(10, u_pain() + 2)"
          ]
        }
      },
      {
        "u_message": "The Brand of Sacrifice burns. A terrifying presence is somewhere nearby.",
        "type": "warning"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_NIGHT_HUNT_QUIET_CHECK",
    "effect": [
      {
        "run_eocs": "EOC_BERSERK_APOSTLE_CHECK_HERE"
      },
      {
        "run_eocs": "EOC_BERSERK_BRAND_NIGHT_HUNT_UNSHELTERED"
      }
    ]
  }
]
