                "math": [
                  "u_berserk_brand_night_spawned += 1"
                ]
              },
              {
                "math": [
                  "u_berserk_brand_night_spawned_total += 1"
                ]
              },
              {
                "math": [
                  "berserk_era_nearby_count += 1"
                ]
              },
              {
                "math": [
                  "berserk_spawn_brand_nearby += 1"
                ]
              }
            ]
          }
        ],
        "false_eocs": [
