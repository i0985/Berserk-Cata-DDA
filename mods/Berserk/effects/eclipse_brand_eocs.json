[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_INSTALL_MARKS",
    "effect": [
      {
        "if": {
          "not": {
            "u_has_bionics": "bio_berserk_brand_of_sacrifice"
          }
        },
        "then": {
          "u_add_bionic": "bio_berserk_brand_of_sacrifice"
        }
      },
      {
        "if": {
          "not": {
            "u_has_bionics": "bio_berserk_lost_eye"
          }
        },
        "then": {
          "u_add_bionic": "bio_berserk_lost_eye"
        }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_RESTORE_OLD_SAVE_MARKS",
    "global": true,
    "recurrence": "1 minute",
    "condition": {
      "and": [
        {
          "math": [
            "berserk_eclipse_era == 1"
          ]
        },
        {
          "math": [
            "u_berserk_eclipse_rescue_state == 2"
          ]
        },
        {
          "or": [
            {
              "not": {
                "u_has_bionics": "bio_berserk_brand_of_sacrifice"
              }
            },
            {
              "not": {
                "u_has_bionics": "bio_berserk_lost_eye"
              }
            }
          ]
        }
      ]
    },
    "effect": {
      "run_eocs": "EOC_BERSERK_ECLIPSE_INSTALL_MARKS"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_NIGHT_HUNT",
    "global": true,
    "recurrence": "1 hour",
    "condition": {
      "and": [
        {
          "u_has_bionics": "bio_berserk_brand_of_sacrifice"
        },
        {
          "math": [
            "berserk_eclipse_era == 1"
          ]
        },
        {
          "math": [
            "u_val('pos_z') == 0"
          ]
        },
        {
          "math": [
            "u_berserk_eclipse_trial_active != 1"
          ]
        },
        {
          "not": "is_day"
        },
        {
          "not": {
            "test_eoc": "EOC_BERSERK_FLORA_NIGHT_QUIET"
          }
        },
        {
          "math": [
            "time('now') >= u_berserk_brand_night_next_attempt"
          ]
        }
      ]
    },
    "effect": [
      {
        "math": [
          "u_berserk_brand_night_last_check = time('now')"
        ]
      },
      {
        "math": [
          "u_berserk_brand_night_requested = 0"
        ]
      },
      {
        "math": [
          "u_berserk_brand_night_attempted = 0"
        ]
      },
      {
        "math": [
          "u_berserk_brand_night_spawned = 0"
        ]
      },
      {
        "math": [
          "u_berserk_brand_night_next_attempt = time('now') + 3600"
        ]
      },
      {
        "set_string_var": "checking",
        "target_var": {
          "u_val": "berserk_brand_night_status"
        }
      },
      {
        "u_location_variable": {
          "context_val": "berserk_near_shelter_ward"
        },
        "furniture": "f_berserk_shelter_ward",
        "target_max_radius": 8,
        "false_eocs": [
          "EOC_BERSERK_BRAND_NIGHT_HUNT_QUIET_CHECK"
        ],
        "target_min_radius": -1,
        "true_eocs": [
          {
            "id": "EOC_BERSERK_BRAND_NIGHT_WARD_QUIET",
            "effect": {
              "set_string_var": "shelter_ward",
              "target_var": {
                "u_val": "berserk_brand_night_status"
              }
            }
          }
        ]
      }
    ],
    "false_effect": [
      {
        "math": [
          "u_berserk_brand_night_last_check = time('now')"
        ]
      },
      {
        "math": [
          "u_berserk_brand_night_requested = 0"
        ]
      },
      {
        "math": [
          "u_berserk_brand_night_attempted = 0"
        ]
      },
      {
        "math": [
          "u_berserk_brand_night_spawned = 0"
        ]
      },
      {
        "if": {
          "not": {
            "u_has_bionics": "bio_berserk_brand_of_sacrifice"
          }
        },
        "then": {
          "set_string_var": "no_brand",
          "target_var": {
            "u_val": "berserk_brand_night_status"
          }
        },
        "else": {
          "if": {
            "math": [
              "berserk_eclipse_era != 1"
            ]
          },
          "then": {
            "set_string_var": "before_eclipse",
            "target_var": {
              "u_val": "berserk_brand_night_status"
            }
          },
          "else": {
            "if": {
              "math": [
                "u_val('pos_z') != 0"
              ]
            },
            "then": {
              "set_string_var": "underground",
              "target_var": {
                "u_val": "berserk_brand_night_status"
              }
            },
            "else": {
              "if": {
                "math": [
                  "u_berserk_eclipse_trial_active == 1"
                ]
              },
              "then": {
                "set_string_var": "eclipse_scene",
                "target_var": {
                  "u_val": "berserk_brand_night_status"
                }
              },
              "else": {
                "if": "is_day",
                "then": {
                  "set_string_var": "daylight",
                  "target_var": {
                    "u_val": "berserk_brand_night_status"
                  }
                },
                "else": {
                  "if": {
                    "test_eoc": "EOC_BERSERK_FLORA_NIGHT_QUIET"
                  },
                  "then": {
                    "set_string_var": "flora_ward",
                    "target_var": {
                      "u_val": "berserk_brand_night_status"
                    }
                  },
                  "else": {
                    "set_string_var": "hour_cooldown",
                    "target_var": {
                      "u_val": "berserk_brand_night_status"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_NIGHT_HUNT_UNSHELTERED",
    "effect": {
      "if": {
        "or": [
          {
            "and": [
              {
                "math": [
                  "u_berserk_breach_sealed == 1"
                ]
              },
              {
                "u_near_om_location": "berserk_local_breach",
                "range": 2
              },
              {
                "math": [
                  "u_berserk_first_breach_registered != 1"
                ]
              }
            ]
          },
          {
            "math": [
              "berserk_apostle_quiet_here == 1"
            ]
          }
        ]
      },
      "then": {
        "if": {
          "x_in_y_chance": {
            "x": 1,
            "y": 3
          }
        },
        "then": {
          "run_eocs": "EOC_BERSERK_BRAND_NIGHT_HUNT_SPAWN"
        },
        "else": {
          "set_string_var": "local_breach_quiet",
          "target_var": {
            "u_val": "berserk_brand_night_status"
          }
        }
      },
      "else": {
        "run_eocs": "EOC_BERSERK_BRAND_NIGHT_HUNT_SPAWN"
      }
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_NIGHT_HUNT_SPAWN",
    "effect": [
      {
        "run_eocs": "EOC_BERSERK_ECLIPSE_ERA_COUNT_NEARBY"
      },
      {
        "math": [
          "u_berserk_brand_night_requested = min(3, max(0, 8 - berserk_era_nearby_count))"
        ]
      },
      {
        "set_string_var": "active_budget",
        "target_var": {
          "u_val": "berserk_brand_night_status"
        }
      },
      {
        "if": {
          "math": [
            "u_berserk_brand_night_requested > 0"
          ]
        },
        "then": [
          {
            "set_string_var": "no_outdoor_cell",
            "target_var": {
              "u_val": "berserk_brand_night_status"
            }
          },
          {
            "run_eocs": "EOC_BERSERK_BRAND_NIGHT_SPAWN_ONE"
          },
          {
            "run_eocs": "EOC_BERSERK_BRAND_NIGHT_SPAWN_ONE"
          },
          {
            "run_eocs": "EOC_BERSERK_BRAND_NIGHT_SPAWN_ONE"
          },
          {
            "if": {
              "math": [
                "u_berserk_brand_night_spawned > 0"
              ]
            },
            "then": [
              {
                "set_string_var": "spawned",
                "target_var": {
                  "u_val": "berserk_brand_night_status"
                }
              },
              {
                "run_eocs": "EOC_BERSERK_BRAND_DEMON_ARRIVAL"
              }
            ]
          }
        ]
      }
    ],
    "//": "Three bounded one-monster requests permit exact success accounting. Count the entire 20-30 tile spawn ring, never refill inside the same hour. No forced target or sound from the hidden player."
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_DEMON_ARRIVAL",
    "effect": {
      "run_eocs": "EOC_BERSERK_BRAND_ORDINARY_WARNING"
    }
  },
