      },
      {
        "run_eocs": "EOC_BERSERK_BRAND_NIGHT_HUNT_UNSHELTERED"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BRAND_NIGHT_SPAWN_ONE",
    "condition": {
      "and": [
        {
          "math": [
            "u_berserk_brand_night_attempted < u_berserk_brand_night_requested"
          ]
        },
        {
          "math": [
            "berserk_era_nearby_count < 8"
          ]
        }
      ]
    },
    "effect": [
      {
        "math": [
          "u_berserk_brand_night_attempted += 1"
        ]
      },
      {
        "u_spawn_monster": "GROUP_BERSERK_BRAND_NIGHT",
        "group": true,
        "single_target": false,
        "real_count": 1,
        "min_radius": 20,
        "max_radius": 30,
        "outdoor_only": true,
        "mon_variables": {
          "berserk_spawn_source": "brand"
        },
        "true_eocs": [
          {
            "id": "EOC_BERSERK_BRAND_NIGHT_ONE_ARRIVED",
            "effect": [
