  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_SITE_COUNT_GUARD",
    "effect": { "math": [ "berserk_site_guard_nearby_count += 1" ] }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_CLAIM_OAK_BEHELIT",
