  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_CHAPEL_RECORD",
    "effect": {
      "u_message": "The inscription reads: \"We hid the red stone in the northern reliquary. Wind the bell, hide, and wait for its delayed peals. The thing follows sounds when it has lost sight of prey. Circle through the broken west wall while it searches the nave.\"",
      "type": "info",
      "popup": true
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_EXPEDITION_RECORD",
    "effect": {
      "u_message": "The final entry reads: \"Specimen: a red stone face, secured in the northeastern tent. A human-shaped predator keeps returning to it. Wind the siren, hide behind the tents before it starts, then approach the case from the other side. Noise cannot distract a creature that still sees you.\"",
      "type": "info",
      "popup": true
    }
  }
