[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_OAK_DISTRACTION",
    "effect": {
      "if": {
        "map_furniture_id": "f_berserk_oak_noisemaker",
        "loc": {
          "context_val": "pos"
        }
      },
      "then": [
        {
          "u_transform_radius": 0,
          "ter_furn_transform": "berserk_oak_noisemaker_arm",
          "target_var": {
            "context_val": "pos"
          }
        },
        {
          "math": [
            "_berserk_noise_z = u_val('pos_z')"
          ]
        },
        {
          "u_message": "You wind the mechanism. The first noise will come from this device in 20 seconds; get behind cover. Four bursts will follow, then it will stop.",
          "type": "info"
        },
        {
          "run_eocs": "EOC_BERSERK_OAK_DISTRACTION_PULSE",
          "time_in_future": "20 seconds"
        },
        {
          "run_eocs": "EOC_BERSERK_OAK_DISTRACTION_PULSE",
          "time_in_future": "35 seconds"
        },
        {
          "run_eocs": "EOC_BERSERK_OAK_DISTRACTION_PULSE",
          "time_in_future": "50 seconds"
        },
        {
          "run_eocs": "EOC_BERSERK_OAK_DISTRACTION_PULSE",
          "time_in_future": "65 seconds"
        },
        {
          "//": "0.I-1 adds one second to delayed transform_radius; 89 + 1 resets at 90 seconds. This world timer survives loss of the activating character.",
          "u_transform_radius": 0,
          "ter_furn_transform": "berserk_noisemakers_reset",
          "target_var": {
            "context_val": "pos"
          },
          "time_in_future": "89 seconds"
        },
        {
          "turn_cost": "1 second"
        }
      ]
    }
  },
