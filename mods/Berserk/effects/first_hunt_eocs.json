          "then": {
            "u_spawn_item": "berserk_first_hunt_directions",
            "count": 1
          }
        },
        {
          "math": [
            "u_berserk_first_hunt_note_given = 1"
          ]
        }
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FIRST_HUNT_ENSURE_BOSS",
