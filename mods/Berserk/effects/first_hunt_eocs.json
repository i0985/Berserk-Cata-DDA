          "math": [
            "u_berserk_first_hunt_done != 1"
          ]
        },
        {
          "math": [
            "u_berserk_first_hunt_spawned != 1"
          ]
        },
        {
          "or": [
            {
              "not": {
                "math": [
                  "has_var(u_berserk_first_hunt_location)"
                ]
              }
            },
            {
              "and": [
                {
                  "math": [
                    "floor(u_berserk_first_hunt_location.x / 24) == floor(u_val('pos_x') / 24)"
                  ]
                },
                {
                  "math": [
                    "floor(u_berserk_first_hunt_location.y / 24) == floor(u_val('pos_y') / 24)"
                  ]
                },
                {
                  "math": [
                    "u_berserk_first_hunt_location.z == u_val('pos_z')"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "effect": [
      {
        "if": {
          "not": {
            "math": [
              "has_var(u_berserk_first_hunt_location)"
            ]
          }
        },
        "then": {
          "u_location_variable": {
            "u_val": "berserk_first_hunt_location"
          },
          "x_adjust": {
            "math": [
              "floor(u_val('pos_x') / 24) * 24 - u_val('pos_x') + 0"
            ]
          },
          "y_adjust": {
            "math": [
              "floor(u_val('pos_y') / 24) * 24 - u_val('pos_y') + 0"
            ]
          }
        }
      },
      {
        "math": [
          "u_berserk_first_hunt_marked = 1"
        ]
      },
      {
        "u_location_variable": {
          "context_val": "berserk_arena_existing"
        },
        "monster": "mon_berserk_hollow_apostle",
        "target_max_radius": 60,
        "true_eocs": [
          "EOC_BERSERK_FIRST_HUNT_ADOPT"
        ],
        "false_eocs": [
          "EOC_BERSERK_FIRST_HUNT_TRY_HIDDEN"
        ]
      }
    ]
  },
