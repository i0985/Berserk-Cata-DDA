          ]
        },
        {
          "math": [
            "u_val('pos_x') - floor(u_val('pos_x') / 24) * 24 <= 15"
          ]
        },
        {
          "math": [
            "u_val('pos_y') - floor(u_val('pos_y') / 24) * 24 >= 8"
          ]
        },
        {
          "math": [
            "u_val('pos_y') - floor(u_val('pos_y') / 24) * 24 <= 15"
