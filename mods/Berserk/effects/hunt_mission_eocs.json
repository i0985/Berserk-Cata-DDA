[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_MISSION_BREACH",
    "condition": {
      "and": [
        {
          "math": [
            "has_var(u_berserk_local_breach_location)"
          ]
        },
        {
          "math": [
            "u_berserk_breach_marked >= 1"
          ]
        }
      ]
    },
    "effect": {
      "if": {
        "math": [
          "u_berserk_breach_sealed == 1"
        ]
      },
      "then": [
        {
          "if": {
            "u_has_mission": "MISSION_BERSERK_BREACH"
          },
          "then": {
            "finish_mission": "MISSION_BERSERK_BREACH",
            "success": true
          }
        },
        {
          "math": [
            "u_berserk_mission_breach_finished = 1"
          ]
        }
      ],
      "else": {
        "if": {
          "and": [
            {
              "not": {
                "u_has_mission": "MISSION_BERSERK_BREACH"
              }
            },
            {
              "math": [
                "u_berserk_mission_breach_finished != 1"
              ]
            }
          ]
        },
        "then": [
          {
            "assign_mission": "MISSION_BERSERK_BREACH"
          },
          {
            "if": {
              "u_has_mission": "MISSION_BERSERK_BREACH"
            },
            "then": [
              {
                "math": [
                  "u_berserk_mission_breach_issued = 1"
                ]
              },
              {
                "u_message": "A new objective has been added to your missions. Select it in the mission journal to follow its exact overmap target; your other hunts remain active.",
                "type": "info"
              }
            ]
          }
        ]
      }
    }
  },
