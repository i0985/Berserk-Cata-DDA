  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_NEXT_STRONGHOLD_GUIDE",
    "condition": {
      "and": [
        {
          "math": [
            "berserk_hunt_count_state >= 4"
          ]
        },
        {
          "math": [
            "berserk_hunt_wyald_state >= 4"
          ]
        },
        {
          "math": [
            "berserk_hunt_rosine_state >= 4"
          ]
        },
        {
          "math": [
            "berserk_hunt_grunbeld_site_registered != 1"
          ]
        },
        {
          "math": [
            "u_val('pos_z') == 0"
          ]
        },
        {
          "math": [
            "berserk_flora_stage != 2"
          ]
        },
        {
          "or": [
            {
              "math": [
                "has_var(u_berserk_site_grunbeld_search_origin) == 0"
              ]
            },
            {
              "math": [
                "u_berserk_site_grunbeld_tries < 3"
              ]
            },
            {
              "math": [
                "distance('u', u_berserk_site_grunbeld_search_origin) >= 24"
              ]
            }
          ]
        }
      ]
    },
    "effect": {
      "run_eocs": "EOC_BERSERK_GRUNBELD_SEEK"
    }
