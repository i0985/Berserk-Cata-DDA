[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_OAK_DISTRACTION_PULSE",
    "eoc_type": "ACTIVATION",
    "//": "Queued activation captures the examined furniture cell in context pos. Skip remote/unloaded-floor pulses; never move the source to the player.",
    "effect": {
      "if": {
        "and": [
          {
            "math": [
              "u_val('pos_z') == _berserk_noise_z"
            ]
          },
          {
            "math": [
              "distance('u', _pos) <= 48"
            ]
          }
        ]
      },
      "then": {
        "if": {
          "map_furniture_id": "f_berserk_oak_noisemaker_armed",
          "loc": {
            "context_val": "pos"
          }
        },
        "then": {
          "u_make_sound": "The bone chimes clatter through the trees!",
          "volume": 45,
          "type": "alarm",
          "ambient": false,
          "target_var": {
            "context_val": "pos"
          }
        }
      }
    }
  },
