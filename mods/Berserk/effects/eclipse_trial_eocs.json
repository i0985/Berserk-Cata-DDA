[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_TRIAL_USE",
    "effect": [
      {
        "if": {
          "or": [
            { "u_at_om_location": "berserk_eclipse_trial" },
            { "u_at_om_location": "berserk_eclipse_trial_flesh" },
            { "u_at_om_location": "berserk_eclipse_dungeon_entry" },
            { "u_at_om_location": "berserk_eclipse_dungeon_gallery" },
            { "u_at_om_location": "berserk_eclipse_dungeon_warrens" },
            { "u_at_om_location": "berserk_eclipse_dungeon_procession" },
            { "u_at_om_location": "berserk_eclipse_dungeon_descent" },
            { "u_at_om_location": "berserk_eclipse_dungeon_altar" }
          ]
        },
        "then": { "run_eocs": "EOC_BERSERK_ECLIPSE_TRIAL_EXIT" },
        "else": {
          "if": { "math": [ "u_berserk_eclipse_rescue_state == 1" ] },
          "then": [
            { "run_eocs": "EOC_BERSERK_ECLIPSE_RESCUE_COMMIT_IF_RETURNED" },
            { "u_message": "The Behelit has gone quiet. The Eclipse has ended for you.", "type": "neutral", "popup": true }
          ],
          "else": {
            "if": {
              "or": [
                { "math": [ "u_berserk_eclipse_rescue_state == 2" ] },
                { "math": [ "u_berserk_eclipse_behelit_spent == 1" ] }
              ]
            },
            "then": { "u_message": "The Behelit has gone quiet. The Eclipse has ended for you.", "type": "neutral", "popup": true },
            "else": { "run_eocs": "EOC_BERSERK_ECLIPSE_TRIAL_ENTER" }
          }
        }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_TRIAL_ENTER",
    "condition": {
      "u_query": "Enter the Eclipse? Only your carried equipment will follow you. The Behelit will be consumed when the passage opens, and there is no path back until the final confrontation.",
      "default": false
    },
    "effect": [
      { "u_location_variable": { "u_val": "berserk_eclipse_return_origin" } },
      { "u_location_variable": { "u_val": "berserk_eclipse_return_east" }, "x_adjust": 6 },
      { "u_location_variable": { "u_val": "berserk_eclipse_return_west" }, "x_adjust": -6 },
      {
        "u_location_variable": { "u_val": "berserk_eclipse_trial_destination" },
        "target_params": {
          "om_terrain": "berserk_eclipse_dungeon_entry",
          "om_special": "berserk_eclipse_dungeon_special_fixed",
          "random": true,
          "search_range": 24,
          "z": -7
        },
        "furniture": "f_berserk_eclipse_arrival_scar",
        "target_max_radius": 20,
        "x_adjust": 1,
        "true_eocs": [ "EOC_BERSERK_ECLIPSE_TRIAL_ARRIVE" ],
        "false_eocs": [ "EOC_BERSERK_ECLIPSE_TRIAL_NO_DESTINATION" ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_TRIAL_ARRIVE",
    "effect": [
      {
        "u_teleport": { "u_val": "berserk_eclipse_trial_destination" },
        "force_safe": true,
        "success_message": "The Behelit draws you onto a field of living flesh. Behind you, the passage seals shut.",
        "fail_message": "The passage does not open.  You remain where you are."
      },
      {
        "if": { "u_at_om_location": "berserk_eclipse_dungeon_entry" },
        "then": [
          { "math": [ "u_berserk_eclipse_trial_active = 1" ] },
          { "math": [ "u_berserk_eclipse_behelit_spent = 1" ] },
          { "u_consume_item": "berserk_behelit", "count": 1 }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_TRIAL_NO_DESTINATION",
    "effect": [ { "u_message": "The Behelit cannot find a safe passage.  Nothing happens.", "type": "bad" } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_TRIAL_EXIT",
    "effect": [
      {
        "if": { "math": [ "u_berserk_eclipse_rescue_state == 1" ] },
        "then": { "run_eocs": "EOC_BERSERK_ECLIPSE_RESCUE_RETURN" },
        "else": {
          "if": { "math": [ "u_berserk_eclipse_behelit_spent == 1" ] },
          "then": { "u_message": "The passage behind you is gone. Only the final confrontation remains.", "type": "warning" },
          "else": {
            "if": { "math": [ "has_var(u_berserk_eclipse_return_origin)" ] },
            "then": { "run_eocs": "EOC_BERSERK_ECLIPSE_TRIAL_RETURN" },
            "else": { "u_message": "No place of return is recorded for you.", "type": "bad" }
          }
        }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_TRIAL_RETURN",
    "condition": { "u_query": "Return to the place where you activated the Behelit? Leave anything on the ground behind.", "default": false },
    "effect": [
      {
        "u_teleport": { "u_val": "berserk_eclipse_return_origin" },
        "force_safe": true,
        "success_message": "The Eclipse recedes.  You return to the world you left.",
        "fail_message": "The return passage is blocked.  Try again from the seal."
      },
      {
        "if": {
          "not": {
            "or": [
              { "u_at_om_location": "berserk_eclipse_trial" },
              { "u_at_om_location": "berserk_eclipse_trial_flesh" },
              { "u_at_om_location": "berserk_eclipse_dungeon_entry" },
              { "u_at_om_location": "berserk_eclipse_dungeon_gallery" },
              { "u_at_om_location": "berserk_eclipse_dungeon_warrens" },
              { "u_at_om_location": "berserk_eclipse_dungeon_procession" },
              { "u_at_om_location": "berserk_eclipse_dungeon_descent" },
              { "u_at_om_location": "berserk_eclipse_dungeon_altar" }
            ]
          }
        },
        "then": [
          { "math": [ "u_berserk_eclipse_trial_active = 0" ] },
          { "run_eocs": "EOC_BERSERK_ECLIPSE_RESCUE_COMMIT_IF_RETURNED" }
        ]
      }
    ]
  }
]
