                    "context_val": "flora_next"
                  },
                  "i18n": true
                },
                "else": {
                  "set_string_var": "Recover at your refuge. Consult your journal for wounds still open and trails you have not completed.",
                  "target_var": {
                    "context_val": "flora_next"
                  },
                  "i18n": true
                }
              }
            }
          }
        }
      },
      {
        "u_message": "Behind you, fire spreads through Flora's home. You have escaped, but a shelter is being lost. Darkness is taking deeper root in the world of Cataclysm; closing every rift will demand far more than the battles won so far.\n\n<context_val:flora_next>",
        "type": "warning",
        "popup": true
      }
    ],
    "condition": {
      "math": [
        "u_berserk_flora_fire_summary_seen != 1"
      ]
    }
