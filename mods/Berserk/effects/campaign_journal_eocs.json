            "then": {
              "set_string_var": "The first hunt is complete. Follow the recovered trail to the Ashen Breach.",
              "target_var": {
                "context_val": "campaign_first"
              },
              "i18n": true
            },
            "else": {
              "set_string_var": "Prepare armor, dressings and a retreat before following the first hunt.",
              "target_var": {
                "context_val": "campaign_first"
              },
              "i18n": true
            }
          }
        }
      },
      {
        "if": {
          "math": [
            "u_berserk_refuge_ready == 1"
