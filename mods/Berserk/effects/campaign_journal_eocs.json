[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_CAMPAIGN_REPORT",
    "effect": {
      "run_eocs": "EOC_BERSERK_JOURNAL_OPEN_CURRENT"
    },
    "condition": {
      "math": [
        "berserk_eclipse_era == 1"
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_CAMPAIGN_CHAPTER_CHECK",
    "effect": [
      {
        "math": [
          "u_berserk_campaign_chapter_closed = 1"
        ]
      }
    ],
    "condition": {
      "and": [
        {
          "math": [
            "u_berserk_campaign_chapter_closed != 1"
          ]
        },
        {
          "math": [
            "berserk_hunt_count_state >= 4"
          ]
        },
        {
          "math": [
            "berserk_hunt_wyald_state >= 4"
          ]
        },
        {
          "math": [
            "berserk_hunt_rosine_state >= 4"
          ]
        },
        {
          "math": [
            "berserk_hunt_grunbeld_state >= 4"
          ]
        },
        {
          "or": [
            {
              "math": [
                "berserk_flora_siege_state >= 5"
              ]
            },
            {
              "math": [
                "berserk_flora_stage == 3"
              ]
            }
          ]
        },
        {
          "math": [
            "berserk_hunt_first_breach_state >= 4"
          ]
        }
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL",
    "effect": {
      "if": {
        "math": [
          "u_berserk_road_journal_issued != 1"
        ]
      },
      "then": [
        {
          "if": {
            "not": {
              "u_has_item": "berserk_campaign_journal"
            }
          },
          "then": {
            "u_spawn_item": "berserk_campaign_journal",
            "count": 1,
            "suppress_message": true
          }
        },
        {
          "math": [
            "u_berserk_road_journal_issued = 1"
          ]
        }
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_CAMPAIGN_POST_FIRE",
    "effect": [
      {
        "math": [
          "u_berserk_flora_fire_summary_seen = 1"
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
      },
      {
        "if": {
          "and": [
            {
              "math": [
                "u_berserk_journal_knows_grunbeld == 1"
              ]
            },
            {
              "not": {
                "test_eoc": "EOC_BERSERK_JOURNAL_DONE_GRUNBELD"
              }
            }
          ]
        },
        "then": {
          "if": {
            "math": [
              "berserk_hunt_grunbeld_state >= 4"
            ]
          },
          "then": {
            "set_string_var": "The wound at Grunbeld’s stronghold is closed. Its unclaimed relic remains on your road.",
            "target_var": {
              "context_val": "flora_next"
            },
            "i18n": true
          },
          "else": {
            "if": {
              "math": [
                "berserk_apostle_grunbeld_dead == 1"
              ]
            },
            "then": {
              "set_string_var": "Grunbeld has fallen, but the wound linked to his stronghold remains to be examined. Keep that unfinished trail in your journal.",
              "target_var": {
                "context_val": "flora_next"
              },
              "i18n": true
            },
            "else": {
              "set_string_var": "The surviving directions point toward Grunbeld’s stronghold. Consult that entry when you are ready to continue.",
              "target_var": {
                "context_val": "flora_next"
              },
              "i18n": true
            }
          }
        },
        "else": {
          "if": {
            "and": [
              {
                "math": [
                  "u_berserk_journal_knows_count == 1"
                ]
              },
              {
                "and": [
                  {
                    "math": [
                      "berserk_hunt_count_state >= 1"
                    ]
                  },
                  {
                    "math": [
                      "berserk_hunt_count_state < 4"
                    ]
                  }
                ]
              }
            ]
          },
          "then": {
            "set_string_var": "The Count's unfinished trail remains in your journal.",
            "target_var": {
              "context_val": "flora_next"
            },
            "i18n": true
          },
          "else": {
            "if": {
              "and": [
                {
                  "math": [
                    "u_berserk_journal_knows_wyald == 1"
                  ]
                },
                {
                  "and": [
                    {
                      "math": [
                        "berserk_hunt_wyald_state >= 1"
                      ]
                    },
                    {
                      "math": [
                        "berserk_hunt_wyald_state < 4"
                      ]
                    }
                  ]
                }
              ]
            },
            "then": {
              "set_string_var": "The Black Dogs' unfinished trail remains in your journal.",
              "target_var": {
                "context_val": "flora_next"
              },
              "i18n": true
            },
            "else": {
              "if": {
                "and": [
                  {
                    "math": [
                      "u_berserk_journal_knows_rosine == 1"
                    ]
                  },
                  {
                    "and": [
                      {
                        "math": [
                          "berserk_hunt_rosine_state >= 1"
                        ]
                      },
                      {
                        "math": [
                          "berserk_hunt_rosine_state < 4"
                        ]
                      }
                    ]
                  }
                ]
              },
              "then": {
                "set_string_var": "The unfinished trail to the misty valley remains in your journal.",
                "target_var": {
                  "context_val": "flora_next"
                },
                "i18n": true
              },
              "else": {
                "if": {
                  "and": [
                    {
                      "math": [
                        "u_berserk_journal_knows_breach == 1"
                      ]
                    },
                    {
                      "and": [
                        {
                          "math": [
                            "u_berserk_breach_sealed != 1"
                          ]
                        },
                        {
                          "math": [
                            "has_var(u_berserk_local_breach_location)"
                          ]
                        }
                      ]
                    }
                  ]
                },
                "then": {
                  "set_string_var": "The ashen breach is still open. Its location remains in your journal.",
                  "target_var": {
                    "context_val": "flora_next"
                  },
                  "i18n": true
                },
                "else": {
                  "set_string_var": "Recover at your refuge. Consult your journal for wounds still open and trails you have not completed.",
                  "target_var": {
                    "context_val": "flora_next"
                  },
                  "i18n": true
                }
              }
            }
          }
        }
      },
      {
        "u_message": "Behind you, fire spreads through Flora's home. You have escaped, but a shelter is being lost. Darkness is taking deeper root in the world of Cataclysm; closing every rift will demand far more than the battles won so far.\n\n<context_val:flora_next>",
        "type": "warning",
        "popup": true
      }
    ],
    "condition": {
      "math": [
        "u_berserk_flora_fire_summary_seen != 1"
      ]
    }
  }
]
