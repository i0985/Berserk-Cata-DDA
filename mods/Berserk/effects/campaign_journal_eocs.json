[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_CAMPAIGN_REPORT",
    "effect": [
      {
        "if": {
          "math": [
            "berserk_hunt_first_breach_state == 3"
          ]
        },
        "then": {
          "set_string_var": "The keeper is defeated. Examine the local breach and seal it.",
          "target_var": {
            "context_val": "campaign_first"
          },
          "i18n": true
        },
        "else": {
          "if": {
            "math": [
              "berserk_hunt_first_breach_state >= 4"
            ]
          },
          "then": {
            "set_string_var": "First hunt and Ashen Breach complete. Their local quiet does not remove the Brand.",
            "target_var": {
              "context_val": "campaign_first"
            },
            "i18n": true
          },
          "else": {
            "if": {
              "math": [
                "u_berserk_first_hunt_done == 1"
              ]
