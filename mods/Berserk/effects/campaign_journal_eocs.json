  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_CAMPAIGN_CHAPTER_CHECK",
    "effect": [
      {
        "math": [
          "u_berserk_campaign_chapter_closed = 1"
        ]
      },
      {
        "u_message": "The named breaches of this chapter are closed. You won breathing room, not an end to the darkness. The Brand endures; distant wounds remain open. Collect any unclaimed relics, tend your refuge and keep the surviving records. The next road has not yet been written.",
        "popup": true,
        "type": "info"
      }
    ],
    "condition": {
      "and": [
        {
          "math": [
            "u_berserk_campaign_chapter_closed != 1"
          ]
        },
        {
          "math": [
            "berserk_hunt_count_state >= 4"
          ]
        },
        {
          "math": [
            "berserk_hunt_wyald_state >= 4"
          ]
        },
        {
          "math": [
            "berserk_hunt_rosine_state >= 4"
          ]
        },
        {
          "math": [
            "berserk_hunt_grunbeld_state >= 4"
          ]
        },
        {
          "or": [
            {
              "math": [
                "berserk_flora_siege_state >= 5"
              ]
            },
            {
              "math": [
                "berserk_flora_stage == 3"
              ]
            }
          ]
        },
        {
          "math": [
            "berserk_hunt_first_breach_state >= 4"
          ]
        }
      ]
    }
  },
  {
