  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL",
    "effect": [
      {
        "if": {
          "math": [
            "u_berserk_road_journal_issued != 1"
          ]
