      {
        "set_string_var": "Each sealed breach quiets NEW world manifestations near its stored site (about two overmap tiles / 48 local tiles). Existing enemies stay. The Brand remains; its night summons and armor shadows follow separate rules.",
        "target_var": {
          "context_val": "campaign_quiet"
        },
        "i18n": true
      },
      {
        "u_message": "THE ROAD AFTER THE ECLIPSE\n\nFirst steps: <context_val:campaign_first>\nRefuge: <context_val:campaign_refuge>\nNight: <context_val:campaign_night>\n\n<context_val:campaign_flora>\n<context_val:campaign_count>\n<context_val:campaign_wyald>\n<context_val:campaign_rosine>\n<context_val:campaign_grunbeld>\n\n<context_val:campaign_quiet>\n\nChoose your next known destination in the mission journal.",
        "popup": true,
        "type": "info"
