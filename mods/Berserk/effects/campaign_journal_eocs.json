  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_CAMPAIGN_POST_FIRE",
    "effect": [
      {
        "math": [
          "u_berserk_flora_fire_summary_seen = 1"
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
      },
      {
        "set_string_var": "Find a place to rest before continuing along the known roads.",
        "target_var": {
          "context_val": "flora_next"
        },
        "i18n": true
      },
      {
        "if": {
          "math": [
            "u_berserk_ref_grunbeld_siege_seen == 1"
          ]
        },
        "then": {
          "set_string_var": "You lost sight of him in the smoke. Whether he lives or is dead is unknown. An empty place is not a dead body.",
          "target_var": {
            "context_val": "flora_next"
          },
          "i18n": true
        }
      },
      {
        "if": {
          "math": [
            "u_berserk_ref_grunbeld_siege_dead == 1"
          ]
        },
        "then": {
          "set_string_var": "Grunbeld is dead. But the wounds bound to him did not disappear with him.",
          "target_var": {
            "context_val": "flora_next"
          },
          "i18n": true
        },
        "else": {
          "if": {
            "math": [
              "u_berserk_ref_grunbeld_siege_alive == 1"
            ]
          },
          "then": {
            "if": {
              "math": [
                "u_berserk_journal_knows_grunbeld == 1"
              ]
            },
            "then": {
              "set_string_var": "Grunbeld survived. The remaining trail leads to his fortress. You can recover your strength before continuing.",
              "target_var": {
                "context_val": "flora_next"
              },
              "i18n": true
            },
            "else": {
              "set_string_var": "Grunbeld survived and vanished in the smoke. Where he went after the battle remains to be discovered.",
              "target_var": {
                "context_val": "flora_next"
              },
              "i18n": true
            }
          }
        }
      },
      {
        "u_message": "Smoke stings your eyes before you realize you are outside. The trees part, and there it is: the great tree, black against the flames. Where windows once stood are only orange hollows, with something moving within them: heat, perhaps, or what remains of the roof.\n\nYou stood by that hearth. Spoke with its mistress and came to know this house. Now it burns, and there is nowhere left to go but forward.\n\nThe closed breaches gave the land a respite, no more. Darkness still seeps into a world that had not recovered from the Cataclysm. You cannot yet begin to imagine how much remains to be done to mend even a little of these wounds.\n\nToday, you stayed alive. For now, that is enough.\n\n<context_val:flora_next>",
        "type": "warning",
        "popup": true
      },
      {
        "run_eocs": "EOC_BERSERK_REF_SYNC"
      }
    ],
    "condition": {
      "math": [
        "u_berserk_flora_fire_summary_seen != 1"
      ]
    }
  }
