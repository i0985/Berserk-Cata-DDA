[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_REFUGE_INSPECT",
    "condition": {
      "and": [
        {
          "math": [
            "distance('u', _pos) <= 1"
          ]
        },
        {
          "map_furniture_id": "f_berserk_shelter_ward",
          "loc": {
            "context_val": "pos"
          }
        }
      ]
    },
    "effect": [
      {
        "u_message": "Within eight local tiles on this level, a bone and stone ward suppresses the Brand's extra nighttime summons, including on the ward's own tile. It does not stop roaming demons, armor-created shadows, zombies or attacks, and does not erase the Brand. Choose an existing defensible building; put your sleeping place inside the ward's reach, prepare light and drinking water, and keep an escape route. The ward needs no fuel or repeated servicing. You can record your own readiness here; light, water and bedding are a checklist, not an automatic safety guarantee.",
        "type": "info",
        "popup": true
      },
      {
        "if": {
          "not": "u_is_outside"
        },
        "then": {
          "if": {
            "u_query": "Record this ward as your prepared refuge? Confirm only after arranging drinking water, light, a sleeping place within eight tiles and an escape route. This records your assessment; it does not build or inspect those supplies for you.",
            "default": false
          },
          "then": {
            "run_eocs": "EOC_BERSERK_REFUGE_REGISTER"
          }
        },
        "else": {
          "u_message": "The ward works outdoors too, but this is not a sheltered sleeping place. Inspect it from inside a nearby building to record a refuge. Do not confuse its limited protection with walls and a roof.",
          "type": "info",
          "popup": false
        }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_REFUGE_REGISTER",
    "condition": {
      "and": [
        {
          "and": [
            {
              "math": [
                "distance('u', _pos) <= 1"
              ]
            },
            {
              "map_furniture_id": "f_berserk_shelter_ward",
              "loc": {
                "context_val": "pos"
              }
            }
          ]
        },
        {
          "not": "u_is_outside"
        }
      ]
    },
    "effect": [
      {
        "if": {
          "or": [
            {
              "not": {
                "math": [
                  "has_var(u_berserk_refuge_ward_location)"
                ]
              }
            },
            {
              "math": [
                "distance(_pos, u_berserk_refuge_ward_location) > 0"
              ]
            }
          ]
        },
        "then": [
          {
            "math": [
              "u_berserk_refuge_night_active = 0"
            ]
          },
          {
            "math": [
              "u_berserk_refuge_night_started = 0"
            ]
          },
          {
            "math": [
              "u_berserk_refuge_night_last = 0"
            ]
          },
          {
            "math": [
              "u_berserk_refuge_dawn_recorded = 0"
            ]
          }
        ]
      },
      {
        "copy_var": {
          "context_val": "pos"
        },
        "target_var": {
          "u_val": "berserk_refuge_ward_location"
        }
      },
      {
        "math": [
          "u_berserk_refuge_ready = 1"
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
      },
      {
        "u_message": "Refuge recorded. Stay within this ward's reach for the Brand's protection; keep watch for creatures that are already here. The refuge journal keeps your preparations and onward directions. It grants no healing, armor or immunity.",
        "type": "good",
        "popup": true
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_REFUGE_JOURNAL",
    "effect": {
      "run_eocs": "EOC_BERSERK_JOURNAL_OPEN_REFUGE"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_REFUGE_NEXT_TRAIL",
    "effect": {
      "run_eocs": "EOC_BERSERK_JOURNAL_OPEN_CURRENT"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_REFUGE_WATCH",
    "condition": {
      "and": [
        {
          "math": [
            "u_berserk_refuge_ready == 1"
          ]
        },
        {
          "math": [
            "berserk_eclipse_era == 1"
          ]
        },
        {
          "u_has_bionics": "bio_berserk_brand_of_sacrifice"
        },
        {
          "math": [
            "u_berserk_eclipse_trial_active != 1"
          ]
        }
      ]
    },
    "effect": {
      "if": {
        "and": [
          {
            "math": [
              "has_var(u_berserk_refuge_ward_location)"
            ]
          },
          {
            "math": [
              "u_berserk_refuge_ward_location.z == u_val('pos_z')"
            ]
          },
          {
            "math": [
              "distance('u', u_berserk_refuge_ward_location) <= 8"
            ]
          }
        ]
      },
      "then": {
        "if": {
          "map_furniture_id": "f_berserk_shelter_ward",
          "loc": {
            "u_val": "berserk_refuge_ward_location"
          }
        },
        "then": {
          "if": {
            "math": [
              "u_berserk_refuge_dawn_recorded != 1"
            ]
          },
          "then": {
            "if": {
              "not": {
                "test_eoc": "EOC_BERSERK_SOLAR_DAY"
              }
            },
            "then": [
              {
                "if": {
                  "math": [
                    "u_berserk_refuge_night_active != 1"
                  ]
                },
                "then": [
                  {
                    "math": [
                      "u_berserk_refuge_night_started = time('now')"
                    ]
                  },
                  {
                    "math": [
                      "u_berserk_refuge_night_active = 1"
                    ]
                  }
                ]
              },
              {
                "math": [
                  "u_berserk_refuge_night_last = time('now')"
                ]
              }
            ],
            "else": {
              "if": {
                "and": [
                  {
                    "math": [
                      "u_berserk_refuge_night_active == 1"
                    ]
                  },
                  {
                    "math": [
                      "time('now') - u_berserk_refuge_night_last <= 120"
                    ]
                  },
                  {
                    "math": [
                      "time('now') - u_berserk_refuge_night_started >= 3600"
                    ]
                  }
                ]
              },
              "then": [
                {
                  "math": [
                    "u_berserk_refuge_dawn_recorded = 1"
                  ]
                },
                {
                  "math": [
                    "u_berserk_refuge_night_active = 0"
                  ]
                },
                {
                  "math": [
                    "u_berserk_refuge_night_started = 0"
                  ]
                },
                {
                  "math": [
                    "u_berserk_refuge_night_last = 0"
                  ]
                },
                {
                  "u_message": "Dawn reaches the refuge. You have survived the night.",
                  "type": "good",
                  "popup": true
                }
              ],
              "else": [
                {
                  "math": [
                    "u_berserk_refuge_night_active = 0"
                  ]
                },
                {
                  "math": [
                    "u_berserk_refuge_night_started = 0"
                  ]
                },
                {
                  "math": [
                    "u_berserk_refuge_night_last = 0"
                  ]
                }
              ]
            }
          }
        },
        "else": [
          {
            "math": [
              "u_berserk_refuge_ready = 0"
            ]
          },
          {
            "math": [
              "u_berserk_refuge_night_active = 0"
            ]
          },
          {
            "math": [
              "u_berserk_refuge_night_started = 0"
            ]
          },
          {
            "math": [
              "u_berserk_refuge_night_last = 0"
            ]
          },
          {
            "u_message": "The recorded ward is gone. Its journal entry no longer marks the refuge as ready; inspect another ward when your preparations are complete.",
            "type": "warning",
            "popup": false
          }
        ]
      },
      "else": [
        {
          "math": [
            "u_berserk_refuge_night_active = 0"
          ]
        },
        {
          "math": [
            "u_berserk_refuge_night_started = 0"
          ]
        },
        {
          "math": [
            "u_berserk_refuge_night_last = 0"
          ]
        }
      ]
    },
    "global": true,
    "recurrence": "1 minute"
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_REFUGE_LEAVE",
    "eoc_type": "EVENT",
    "required_event": "avatar_moves",
    "condition": {
      "and": [
        {
          "math": [
            "u_berserk_refuge_ready == 1"
          ]
        },
        {
          "math": [
            "u_berserk_refuge_night_active == 1"
          ]
        },
        {
          "not": {
            "and": [
              {
                "math": [
                  "has_var(u_berserk_refuge_ward_location)"
                ]
              },
              {
                "math": [
                  "u_berserk_refuge_ward_location.z == u_val('pos_z')"
                ]
              },
              {
                "math": [
                  "distance('u', u_berserk_refuge_ward_location) <= 8"
                ]
              }
            ]
          }
        }
      ]
    },
    "effect": [
      {
        "math": [
          "u_berserk_refuge_night_active = 0"
        ]
      },
      {
        "math": [
          "u_berserk_refuge_night_started = 0"
        ]
      },
      {
        "math": [
          "u_berserk_refuge_night_last = 0"
        ]
      }
    ]
  }
]
