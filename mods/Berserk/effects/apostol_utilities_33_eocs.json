[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_UTILITY29_EARLY_REQUEST",
    "effect": [
      {
        "if": {
          "math": [
            "u_berserk_early_caravan_attempts == 0"
          ]
        },
        "then": {
          "u_location_variable": {
            "u_val": "berserk_early_caravan_origin"
          }
        }
      },
      {
        "math": [
          "u_berserk_early_caravan_attempts = u_berserk_early_caravan_attempts + 1"
        ]
      },
      {
        "math": [
          "u_berserk_early_caravan_retry_at = time('now') + time('30 minutes')"
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_UTILITY29_EARLY_FIND"
      }
    ],
    "condition": {
      "and": [
        "u_is_avatar",
        {
          "math": [
            "u_val('pos_z') == 0"
          ]
        },
        {
          "or": [
            {
              "not": "u_is_outside"
            },
            {
              "u_at_om_location": "field"
            },
            {
              "u_at_om_location": "forest"
            },
            {
              "u_at_om_location": "forest_thick"
            },
            {
              "u_at_om_location": "road"
            }
          ]
        },
        {
          "not": {
            "math": [
              "u_berserk_eclipse_trial_active == 1"
            ]
          }
        },
        {
          "not": {
            "math": [
              "berserk_early_caravan_placed == 1"
            ]
          }
        },
        {
          "math": [
            "u_berserk_early_caravan_attempts < 3"
          ]
        },
        {
          "math": [
            "time('now') >= u_berserk_early_caravan_retry_at"
          ]
        }
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_UTILITY29_EARLY_FIND",
