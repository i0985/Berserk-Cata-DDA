    "recurrence": "1 minute",
    "condition": {
      "and": [
        {
          "math": [
            "u_berserk_eclipse_rescue_state == 2"
          ]
        },
        {
          "math": [
            "u_berserk_knight_return_fix != 1"
          ]
        },
        {
          "compare_string": [
            "yes",
            {
              "u_val": "berserk_knight_farewell"
            }
          ]
        },
        {
          "math": [
            "u_berserk_knight_farewell_confirmed != 1"
          ]
        }
      ]
    },
    "effect": [
      {
        "math": [
          "u_berserk_knight_return_fix = 1"
        ]
      },
      {
        "u_add_var": "berserk_knight_farewell",
        "value": "no"
      },
      {
        "if": {
          "math": [
            "u_monsters_nearby('mon_skull_knight_rescuer', 'radius': 60, 'attitude': 'both') > 0"
          ]
        },
        "then": {
          "u_add_var": "berserk_knight_waiting",
          "value": "placed"
        },
        "else": [
          {
            "u_add_var": "berserk_knight_waiting",
            "value": "yes"
          },
          {
            "run_eocs": "EOC_BERSERK_ECLIPSE_KNIGHT_RETRY"
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ECLIPSE_PLACE_KNIGHT",
    "condition": {
      "and": [
        {
          "math": [
            "u_berserk_knight_farewell_confirmed != 1"
          ]
        },
        {
          "compare_string": [
            "yes",
            {
              "u_val": "berserk_knight_waiting"
            }
          ]
        }
      ]
    },
    "effect": [
      {
        "math": [
          "berserk_knight_local_present = 0"
        ]
      },
      {
        "math": [
          "berserk_knight_probe_z = u_val('pos_z')"
        ]
      },
      {
        "if": {
          "and": [
            {
              "math": [
                "u_berserk_godo_rescue_relocated == 1"
              ]
