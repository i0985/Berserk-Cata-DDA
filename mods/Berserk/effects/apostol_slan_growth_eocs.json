[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_APOSTOL_SLAN_LINE",
    "effect": [],
    "condition": {
      "and": [
        "u_is_avatar",
        {
          "math": [
            "u_berserk_apostol_path == 1"
          ]
        },
        {
          "math": [
            "u_berserk_apostol_lineage == 2"
          ]
        },
        {
          "math": [
            "u_berserk_apostol_return_state == 2"
          ]
        }
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_APOSTOL_SLAN_BEGIN",
    "effect": [
      {
        "math": [
          "u_berserk_apostol_started_at = time('now')"
        ]
      },
      {
        "math": [
          "u_berserk_apostol_growth_step = 0"
        ]
      },
      {
        "math": [
          "u_berserk_apostol_growth_running = 1"
        ]
      },
      {
        "if": {
          "not": {
            "u_has_trait": "BERSERK_SLAN_SEED"
          }
        },
        "then": {
          "u_add_trait": "BERSERK_SLAN_SEED"
        }
      },
      {
        "run_eocs": "EOC_BERSERK_APOSTOL_FIRST_BODY_CHANGE"
      }
    ],
    "condition": {
      "and": [
        {
          "test_eoc": "EOC_BERSERK_APOSTOL_SLAN_LINE"
        },
        {
          "math": [
            "u_berserk_apostol_stage == 1"
          ]
        },
        {
          "not": {
            "math": [
              "has_var(u_berserk_apostol_started_at)"
            ]
          }
        }
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_APOSTOL_SLAN_GROW",
    "effect": [
      {
        "if": {
          "and": [
            {
              "math": [
                "u_berserk_apostol_growth_step == 0"
              ]
            },
            {
              "math": [
                "time('now') - u_berserk_apostol_started_at >= time('6 hours')"
              ]
            }
          ]
        },
        "then": [
          {
            "if": {
              "not": {
                "u_has_trait": "BERSERK_SLAN_SENSES"
              }
            },
            "then": {
              "u_add_trait": "BERSERK_SLAN_SENSES"
            }
          },
          {
            "math": [
              "u_berserk_apostol_growth_step = 1"
            ]
          },
          {
            "math": [
              "u_berserk_apostol_stage = 2"
            ]
          },
          {
            "u_message": "Your eyes follow movement in the dark before you consciously notice it.",
            "type": "warning"
          }
        ]
      },
      {
        "if": {
          "and": [
            {
              "math": [
                "u_berserk_apostol_growth_step == 1"
              ]
            },
            {
              "math": [
                "time('now') - u_berserk_apostol_started_at >= time('18 hours')"
              ]
            }
          ]
        },
        "then": [
          {
            "if": {
              "not": {
                "u_has_trait": "BERSERK_SLAN_FORM"
              }
            },
            "then": {
              "u_add_trait": "BERSERK_SLAN_FORM"
            }
          },
          {
            "math": [
              "u_berserk_apostol_growth_step = 2"
            ]
          },
          {
            "u_message": "Your flesh settles into an unfamiliar shape.",
            "type": "warning"
          }
        ]
      },
      {
        "if": {
          "and": [
            {
              "math": [
                "u_berserk_apostol_growth_step == 2"
              ]
            },
            {
              "math": [
                "time('now') - u_berserk_apostol_started_at >= time('36 hours')"
              ]
            }
          ]
        },
        "then": [
          {
            "if": {
              "not": {
                "u_has_trait": "BERSERK_SLAN_WHIP"
              }
            },
            "then": {
              "u_add_trait": "BERSERK_SLAN_WHIP"
            }
          },
          {
            "math": [
              "u_berserk_apostol_growth_step = 3"
            ]
          },
          {
            "u_message": "An impulse travels down your arm. A cord of living flesh snaps outward, then draws back beneath your skin.",
            "type": "warning"
          }
        ]
      },
      {
        "if": {
          "and": [
            {
              "math": [
                "u_berserk_apostol_growth_step == 3"
              ]
            },
            {
              "math": [
                "time('now') - u_berserk_apostol_started_at >= time('60 hours')"
              ]
            }
          ]
        },
        "then": [
          {
            "if": {
              "not": {
                "u_has_trait": "BERSERK_SLAN_MEND"
              }
            },
            "then": {
              "u_add_trait": "BERSERK_SLAN_MEND"
            }
          },
          {
            "math": [
              "u_berserk_apostol_growth_step = 4"
            ]
          },
          {
            "if": {
              "not": {
                "u_has_trait": "BERSERK_SLAN_APOSTLE"
              }
            },
            "then": {
              "u_add_trait": "BERSERK_SLAN_APOSTLE"
            }
          },
          {
            "math": [
              "u_berserk_apostol_stage = 3"
            ]
          },
          {
            "math": [
              "u_berserk_apostol_growth_running = 0"
            ]
          },
          {
            "u_message": "The second pulse settles into your heartbeat. Your new flesh has finished growing; now its strength is yours to spend.",
            "type": "warning"
          }
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_APOSTOL_FIRST_BODY_CHANGE"
      }
    ],
    "condition": {
      "and": [
        {
          "test_eoc": "EOC_BERSERK_APOSTOL_SLAN_LINE"
        },
        {
          "math": [
            "u_berserk_apostol_growth_running == 1"
          ]
        },
        {
          "math": [
            "has_var(u_berserk_apostol_started_at)"
          ]
        },
        {
          "math": [
            "u_berserk_apostol_stage < 3"
          ]
        }
      ]
    },
    "eoc_type": "RECURRING",
    "recurrence": "1 minute",
    "deactivate_condition": {
      "math": [
        "u_berserk_apostol_stage >= 3"
      ]
    },
    "global": true
  },
