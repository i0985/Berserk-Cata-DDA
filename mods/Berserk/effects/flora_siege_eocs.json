  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_START_SIEGE",
    "effect": [
      {
        "u_location_variable": {
          "context_val": "flora_player_pos"
        }
      },
      {
        "if": {
          "and": [
            "u_is_avatar",
            {
              "and": [
                {
                  "math": [
                    "berserk_eclipse_era == 1"
                  ]
                },
                {
                  "math": [
                    "u_berserk_eclipse_rescue_state == 2"
                  ]
                }
              ]
            },
            {
              "or": [
                {
                  "u_at_om_location": "berserk_flora_manor_west"
                },
                {
                  "u_at_om_location": "berserk_flora_manor_east"
                },
                {
                  "u_at_om_location": "berserk_flora_garden_west"
                },
                {
                  "u_at_om_location": "berserk_flora_garden_east"
                }
              ]
            },
            {
              "math": [
                "berserk_flora_siege_state == 1"
              ]
            },
            {
              "math": [
                "berserk_flora_stage == 1"
              ]
            }
          ]
        },
        "then": {
          "if": {
            "u_query": "Begin the one-time attack now? Prepare your armor first. The sanctuary will be lost; escape through the western road or southern garden.",
            "default": false
          },
          "then": [
            {
              "math": [
                "berserk_flora_siege_state = 2"
              ]
            },
            {
              "math": [
                "berserk_flora_stage = 2"
              ]
            },
            {
              "math": [
                "berserk_flora_siege_started = time('now')"
              ]
            },
            {
              "run_eocs": "EOC_BERSERK_FLORA_UPDATE_WARNING"
            },
            {
              "u_spawn_monster": "mon_berserk_flora_root_guard",
              "real_count": 1,
              "min_radius": 0,
              "max_radius": 2,
              "target_var": {
                "global_val": "berserk_flora_guard_north_anchor"
              },
              "friendly": true,
              "lifespan": "10 minutes"
            },
            {
              "u_spawn_monster": "mon_berserk_flora_root_guard",
              "real_count": 1,
              "min_radius": 0,
              "max_radius": 2,
              "target_var": {
                "global_val": "berserk_flora_guard_east_anchor"
              },
              "friendly": true,
              "lifespan": "10 minutes"
            },
            {
              "u_make_sound": "wood cracking beyond the ward",
              "volume": 36,
              "type": "combat",
              "target_var": {
                "global_val": "berserk_flora_zodd_anchor"
              }
            },
            {
              "u_message": "The ward trembles. Root guardians rise outside the house as footsteps approach from the north and east. ESCAPE: use the western door or the southern door, then follow the ash-marked path beyond the grove. Zodd and Grunbeld arrive in about 30 seconds. Escape, not victory, is the objective.",
              "type": "warning",
              "popup": true
            }
          ]
        },
        "else": {
          "u_message": "The charm cannot begin another attack. Prepare with Flora after the Eclipse, then activate it in her still-peaceful manor.",
          "type": "warning",
          "popup": true
        }
      }
    ]
  },
