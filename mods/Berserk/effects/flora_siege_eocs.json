            "overmap_tile": true,
            "x_adjust": 0,
            "y_adjust": 0
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_LEGACY_ZODD_DIES",
    "effect": [
      {
        "run_eocs": "EOC_BERSERK_FLORA_ZODD_DIES"
      },
      {
        "run_eocs": "EOC_BERSERK_BEHELIT_BOSS_DIES"
      }
    ]
  },
  {
