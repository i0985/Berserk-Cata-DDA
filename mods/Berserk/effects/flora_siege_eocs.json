[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_CAN_PREPARE_SIEGE",
    "effect": [],
    "condition": {
      "and": [
        {
          "and": [
            {
              "math": [
                "berserk_eclipse_era == 1"
              ]
            },
            {
              "math": [
                "u_berserk_eclipse_rescue_state == 2"
              ]
            }
          ]
        },
        {
          "and": [
            "has_beta",
            "npc_is_monster",
            {
              "math": [
                "n_monsters_nearby('mon_berserk_flora', 'radius': 0, 'attitude': 'both') > 0"
              ]
            }
          ]
        },
        {
          "and": [
            {
              "math": [
                "has_var(berserk_flora_location)"
              ]
            },
            {
              "math": [
                "has_var(berserk_flora_center)"
              ]
            },
            {
              "or": [
                {
                  "npc_at_om_location": "berserk_flora_manor_west"
                },
                {
                  "npc_at_om_location": "berserk_flora_manor_east"
                },
                {
                  "npc_at_om_location": "berserk_flora_garden_west"
                },
                {
                  "npc_at_om_location": "berserk_flora_garden_east"
                }
              ]
            },
            {
              "math": [
                "distance('npc', berserk_flora_center) <= 34"
              ]
            }
          ]
        },
        {
          "math": [
            "berserk_flora_stage == 1"
          ]
        },
        {
          "math": [
            "berserk_flora_siege_state == 0"
          ]
        },
        {
          "or": [
            {
              "test_eoc": "EOC_BERSERK_FLORA_FULL_SET"
            },
            {
              "math": [
                "u_berserk_flora_armor_resolved == 1"
              ]
            },
            {
              "test_eoc": "EOC_BERSERK_FLORA_CAN_RECEIVE"
            }
          ]
        }
      ]
    }
  },
