  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_SIEGE_TICK",
    "effect": [
      {
        "u_location_variable": {
          "context_val": "flora_player_pos"
        }
      },
      {
        "if": {
          "not": {
            "test_eoc": "EOC_BERSERK_FLORA_INSIDE_SIEGE"
          }
        },
        "then": {
          "run_eocs": "EOC_BERSERK_FLORA_ESCAPED"
        },
        "else": [
          {
            "if": {
              "and": [
                {
                  "math": [
                    "berserk_flora_siege_state == 2"
                  ]
                },
                {
                  "math": [
                    "time('now') - berserk_flora_siege_started >= 30"
                  ]
                }
              ]
            },
            "then": {
              "run_eocs": "EOC_BERSERK_FLORA_APOSTLES_ARRIVE"
            }
          },
          {
            "if": {
              "and": [
                {
                  "math": [
                    "berserk_flora_siege_state >= 3"
                  ]
                },
                {
                  "math": [
                    "time('now') - berserk_flora_zodd_last_try >= 10"
                  ]
                }
              ]
            },
            "then": {
              "run_eocs": "EOC_BERSERK_FLORA_SPAWN_ZODD"
            }
          },
          {
            "if": {
              "and": [
                {
                  "math": [
                    "berserk_flora_siege_state >= 3"
                  ]
                },
                {
                  "math": [
                    "time('now') - berserk_flora_grunbeld_last_try >= 10"
                  ]
                }
              ]
            },
            "then": {
              "run_eocs": "EOC_BERSERK_FLORA_SPAWN_GRUNBELD"
            }
          },
          {
            "if": {
              "and": [
                {
                  "math": [
                    "berserk_flora_siege_state == 3"
                  ]
                },
                {
                  "math": [
                    "time('now') - berserk_flora_siege_started >= 90"
                  ]
                }
              ]
            },
            "then": {
              "run_eocs": "EOC_BERSERK_FLORA_COLLAPSE"
            }
          }
        ]
      }
    ],
    "condition": {
      "and": [
        {
          "math": [
            "berserk_flora_siege_state >= 2"
          ]
        },
        {
          "math": [
            "berserk_flora_siege_state <= 4"
          ]
        }
      ]
    },
    "global": true,
    "recurrence": "1 second"
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_REMOVE_SCENE_ACTOR",
    "effect": [
      {
        "u_location_variable": {
          "context_val": "flora_actor_pos"
        }
      },
      {
        "if": {
          "math": [
            "distance(_flora_actor_pos, berserk_flora_center) <= 32"
          ]
        },
        "then": {
          "u_die": {
            "remove_from_creature_tracker": true
          }
        }
      }
    ],
    "condition": {
      "math": [
        "has_var(berserk_flora_center)"
      ]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_RUINS_CLEANUP",
    "effect": {
      "u_run_monster_eocs": [
        "EOC_BERSERK_FLORA_REMOVE_SCENE_ACTOR"
      ],
      "mtype_ids": [
        "mon_berserk_flora",
        "mon_berserk_flora_root_guard"
      ],
      "monster_range": 100
    },
    "global": true,
    "recurrence": "10 seconds",
    "condition": {
      "and": [
        {
          "math": [
            "berserk_flora_stage == 3"
          ]
        },
        {
          "math": [
            "u_monsters_nearby('mon_berserk_flora', 'mon_berserk_flora_root_guard', 'radius': 100, 'attitude': 'both') > 0"
          ]
        }
      ]
    }
  },
  {
