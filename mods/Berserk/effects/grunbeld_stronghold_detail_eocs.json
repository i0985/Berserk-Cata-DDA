  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_GRUNBELD_READ_BADGE",
    "effect": [
      {
        "u_message": "A burned clasp is all that remains of the garrison standard. No magic lives in it. Names scratched into the back remember those who held the southern road open. Keep it as testimony; the Carapace Shard belongs to the apostle, not to these fallen soldiers.",
        "popup": true,
        "type": "info"
      },
      {
        "if": {
          "and": [
            {
              "math": [
                "berserk_apostle_grunbeld_dead == 1"
              ]
            },
            {
              "math": [
                "berserk_hunt_grunbeld_defeated_in_lair != 1"
              ]
            }
          ]
        },
        "then": {
          "u_message": "Grunbeld died at Flora's grove. The fortress still holds his unsealed wound and the garrison's testimony, not another living original or another Carapace Shard.",
          "popup": true,
          "type": "info"
        }
      }
    ]
  }
]
