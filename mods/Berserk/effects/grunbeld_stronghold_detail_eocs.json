[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_GRUNBELD_READ_SIEGE_ORDERS",
    "effect": {
      "u_message": "\"The shields at the gate are lost. Keep the broken mantlets standing until the wounded have passed. Send the second squad through the quarry cut. Do not crowd the inner road.\" The last lines are burned away.",
      "popup": true,
      "type": "info"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_GRUNBELD_READ_GARRISON_ROLL",
    "effect": {
      "u_message": "Names are crossed out by squads. The barracks held the wounded; the smith kept repairing shields after the inner wall fell. A charcoal arrow points toward the southern breach. This was a working garrison before it became an apostle's hunting ground.",
      "popup": true,
      "type": "info"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_GRUNBELD_READ_QUARRY_NOTE",
    "effect": {
      "u_message": "A workman scratched an arrow beneath the hoist: \"The drum is jammed. Take the spare rope beside it; leave the loads. Follow the cut south and make for the breach by the smithy.\" Drag marks follow the same bend around the stone faces.",
      "popup": true,
      "type": "info"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_GRUNBELD_READ_SOLDIER_LETTER",
    "effect": {
      "u_message": "I kept my bed made so they would think I was coming back. The cook still leaves bread for the smith. We hear hammering from below, though no one has returned from the inner court. If the southern road is open, do not wait for my squad.",
      "popup": true,
      "type": "info"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_GRUNBELD_READ_DRESSER_NOTE",
    "effect": {
      "u_message": "\"Keep the clean water for the wounded. Tear the spare linen into strips. More men arrived burned inside their padded coats; do not send anyone back for the shields.\" A nearly empty bottle stands beside the tally.",
      "popup": true,
      "type": "info"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_GRUNBELD_READ_SMITH_NOTE",
    "effect": {
      "u_message": "\"The shield buckled before I could lift it. The timber screen behind it caught fire, but the old stone pier stood. I have moved the tools to the lower room. If the court must be crossed, keep masonry between you and that furnace.\"",
      "popup": true,
      "type": "info"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_GRUNBELD_READ_INNER_WARNING",
    "effect": {
      "u_message": "Orders are scratched into the broken door: \"Leave the stores. Bring the wounded through the western smithy or the southern breach. The inner hall cannot be held.\" Deep scorch marks continue into the court.",
      "popup": true,
      "type": "info"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_GRUNBELD_READ_LAST_WARNING",
    "effect": {
      "u_message": "Heat has eaten through the shield, but the broken stone behind it is intact. Several separate bulwarks cross the courtyard. None protects every approach. The northern opening and western repair court lead in; the southern breach remains a way out.",
      "popup": true,
      "type": "info"
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_GRUNBELD_READ_FALLEN_GARRISON",
    "effect": {
      "u_message": "Broken spearheads point back toward the hall while discarded packs lead south. The defenders were covering a retreat. Beneath the fallen stone the earth still pulses, drawing ash into the wound instead of letting it settle.",
      "popup": true,
      "type": "info"
    }
  },
