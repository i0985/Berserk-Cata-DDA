[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_HOLLOW_COMMITTED_BEGIN",
    "condition": {
      "and": [
        {
          "math": [
            "n_hp('ALL') > 0"
          ]
        },
        {
          "not": {
            "npc_has_effect": "berserk_hollow_hook_ready"
          }
        },
        {
          "not": {
            "npc_has_effect": "berserk_apostle_attack_recovery"
          }
        },
        {
          "math": [
            "time('now') >= n_berserk_committed_hollow_cooldown"
          ]
        },
        {
          "math": [
            "n_berserk_committed_hollow_phase != 1"
          ]
        }
      ]
    },
    "effect": [
      {
        "u_location_variable": {
          "npc_val": "berserk_committed_hollow_target"
        }
      },
      {
        "npc_location_variable": {
          "npc_val": "berserk_committed_hollow_origin"
        }
      },
      {
        "math": [
          "n_berserk_committed_hollow_last_result = 1"
        ]
      },
      {
        "math": [
          "n_berserk_committed_hollow_phase = 1"
        ]
      },
      {
        "math": [
          "n_berserk_committed_hollow_due = time('now') + 2"
        ]
      },
      {
        "npc_add_effect": "berserk_hollow_hook_ready",
        "duration": "3 seconds",
        "intensity": 1
      },
      {
        "npc_cast_spell": {
          "id": "berserk_committed_hollow_warning",
          "min_level": 0
        },
        "targeted": false,
        "loc": {
          "npc_val": "berserk_committed_hollow_target"
        }
      }
    ],
    "//": "Spell EOC: alpha=victim, beta=caster. Snapshot all direction/cells onto the caster before warning."
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_HOLLOW_COMMITTED_CLEAR_WARNING",
    "condition": {
      "math": [
        "has_var(u_berserk_committed_hollow_origin)"
      ]
    },
    "effect": {
      "u_transform_radius": 2,
      "ter_furn_transform": "berserk_committed_hollow_clear_warning",
      "target_var": {
        "u_val": "berserk_committed_hollow_origin"
      }
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_HOLLOW_COMMITTED_RECOVER",
    "effect": [
      {
        "u_lose_effect": "berserk_hollow_hook_ready"
      },
      {
        "u_add_effect": "berserk_apostle_attack_recovery",
        "duration": "2 seconds",
        "intensity": 1
      },
      {
        "math": [
          "u_berserk_committed_hollow_cooldown = time('now') + 10"
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_HOLLOW_COMMITTED_RELEASE",
    "effect": [
      {
        "math": [
          "u_berserk_committed_hollow_phase = 0"
        ]
      },
      {
        "math": [
          "u_berserk_committed_hollow_last_result = 2"
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_HOLLOW_COMMITTED_CLEAR_WARNING"
      },
      {
        "u_cast_spell": {
          "id": "berserk_committed_hollow_release",
          "min_level": 0
        },
        "targeted": false,
        "loc": {
          "u_val": "berserk_committed_hollow_target"
        }
      },
      {
        "u_make_sound": "Hooked arms tear across the bare ground!",
        "type": "combat",
        "volume": 20
      },
      {
        "run_eocs": "EOC_BERSERK_HOLLOW_COMMITTED_RECOVER"
      }
    ],
    "//": "Commit once before damage. Fixed saved geometry; no reacquisition of the avatar."
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_HOLLOW_COMMITTED_CANCEL",
    "effect": [
      {
        "math": [
          "u_berserk_committed_hollow_phase = 0"
        ]
      },
      {
        "if": {
          "math": [
            "u_hp('ALL') <= 0"
          ]
        },
        "then": {
          "math": [
            "u_berserk_committed_hollow_last_result = 5"
          ]
        },
        "else": {
          "if": {
            "math": [
              "time('now') > u_berserk_committed_hollow_due + 1"
            ]
          },
          "then": {
            "math": [
              "u_berserk_committed_hollow_last_result = 3"
            ]
          },
          "else": {
            "math": [
              "u_berserk_committed_hollow_last_result = 4"
            ]
          }
        }
      },
      {
        "run_eocs": "EOC_BERSERK_HOLLOW_COMMITTED_CLEAR_WARNING"
      },
      {
        "u_lose_effect": "berserk_hollow_hook_ready"
      },
      {
        "u_add_effect": "berserk_apostle_attack_recovery",
        "duration": "1 second",
        "intensity": 1
      },
      {
        "math": [
          "u_berserk_committed_hollow_cooldown = time('now') + 5"
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_HOLLOW_COMMITTED_TICK",
    "condition": {
      "or": [
        {
          "math": [
            "u_berserk_committed_hollow_phase == 1"
          ]
        },
        {
          "u_has_effect": "berserk_hollow_hook_ready"
        }
      ]
    },
    "effect": {
      "if": {
        "and": [
          {
            "math": [
              "u_berserk_committed_hollow_phase == 1"
            ]
          },
          {
            "math": [
              "u_hp('ALL') > 0"
            ]
          },
          {
            "math": [
              "has_var(u_berserk_committed_hollow_origin)"
            ]
          },
          {
            "math": [
              "has_var(u_berserk_committed_hollow_target)"
            ]
          },
          {
            "u_has_effect": "berserk_hollow_hook_ready"
          },
          {
            "math": [
              "distance('u', u_berserk_committed_hollow_origin) == 0"
            ]
          },
          {
            "math": [
              "time('now') <= u_berserk_committed_hollow_due + 1"
            ]
          },
          {
            "not": {
              "u_has_effect": "stunned"
            }
          },
          {
            "not": {
              "u_has_effect": "downed"
            }
          }
        ]
      },
      "then": {
        "if": {
          "math": [
            "time('now') >= u_berserk_committed_hollow_due"
          ]
        },
        "then": {
          "run_eocs": "EOC_BERSERK_HOLLOW_COMMITTED_RELEASE"
        }
      },
      "else": {
        "run_eocs": "EOC_BERSERK_HOLLOW_COMMITTED_CANCEL"
      }
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_HOLLOW_COMMITTED_WATCH",
    "recurrence": "1 second",
    "effect": {
      "u_run_monster_eocs": [
        "EOC_BERSERK_HOLLOW_COMMITTED_TICK"
      ],
      "mtype_ids": [
        "mon_berserk_hollow_apostle"
      ],
      "monster_range": 48
    },
    "global": true
  }
]
