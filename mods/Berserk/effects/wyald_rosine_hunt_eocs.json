  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_WYALD_FIND",
    "effect": [
      {
        "if": {
          "or": [
            {
              "math": [
                "has_var(u_berserk_site_wyald_search_origin) == 0"
              ]
            },
            {
              "math": [
                "distance('u', u_berserk_site_wyald_search_origin) >= 24"
              ]
            }
          ]
        },
        "then": [
          {
            "math": [
              "u_berserk_site_wyald_tries = 0"
            ]
          },
          {
            "u_location_variable": {
              "u_val": "berserk_site_wyald_search_origin"
            }
          }
        ]
      },
      {
        "if": {
          "math": [
            "u_berserk_site_wyald_tries < 3"
          ]
        },
        "then": [
          {
            "math": [
              "u_berserk_site_wyald_tries = u_berserk_site_wyald_tries + 1"
            ]
          },
          {
            "u_location_variable": {
              "context_val": "berserk_site_wyald_candidate"
            },
            "target_params": {
              "om_terrain": "berserk_wyald_ring",
              "om_special": "berserk_wyald_camp_special",
              "search_range": 35,
              "random": true,
              "z": 0,
              "min_distance": 15
            },
            "furniture": "f_berserk_wyald_breach",
            "target_max_radius": 23,
            "true_eocs": [
              "EOC_BERSERK_SITE_WYALD_VALIDATE"
            ],
            "false_eocs": [
              "EOC_BERSERK_SITE_WYALD_FAILED"
            ]
          }
        ],
        "else": {
          "run_eocs": "EOC_BERSERK_SITE_WYALD_MESSAGE"
        }
      }
    ]
  },
