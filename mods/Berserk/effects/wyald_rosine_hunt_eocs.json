          },
          "radius": 1
        },
        {
          "u_message": "Wyald's Black Dog encampment is marked on your map. Follow the broken cart tracks east or circle through the western quarry. The killing ring lies in the southeast; Wyald appears when you enter it.",
          "type": "info",
          "popup": true
        },
        {
          "run_eocs": "EOC_BERSERK_MISSIONS_SYNC"
        }
      ],
      "else": {
        "run_eocs": "EOC_BERSERK_WYALD_FIND"
      }
    },
    "false_effect": {
      "u_message": "Follow named apostle trails above ground after the Eclipse and the first hunt.",
