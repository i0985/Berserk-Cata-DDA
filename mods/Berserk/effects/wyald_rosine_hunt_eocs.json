        {
          "and": [
            {
              "math": [
                "berserk_eclipse_era == 1"
              ]
            },
            {
              "math": [
                "u_berserk_eclipse_trial_active != 1"
              ]
            },
            {
              "math": [
                "u_berserk_eclipse_rescue_state == 2"
              ]
            }
          ]
        },
        {
          "math": [
            "u_berserk_first_hunt_done == 1"
          ]
        },
