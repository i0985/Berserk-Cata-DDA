  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_FLORA_SEEK",
    "false_effect": {
      "u_message": "Recover after the Eclipse and complete the first hunt, then ask the Skull Knight about Flora above ground.",
      "type": "info",
      "popup": true
    },
    "condition": {
      "and": [
        {
          "and": [
            {
              "math": [
                "berserk_eclipse_era == 1"
              ]
            },
            {
              "math": [
                "u_berserk_eclipse_rescue_state == 2"
              ]
            }
          ]
        },
        {
          "math": [
            "u_berserk_first_hunt_done == 1"
          ]
        },
        {
          "math": [
            "u_val('pos_z') == 0"
          ]
        }
      ]
    },
    "effect": {
      "if": {
        "and": [
          {
            "math": [
              "has_var(berserk_flora_location)"
            ]
          },
          {
            "math": [
              "berserk_flora_stage >= 1"
            ]
          }
        ]
      },
      "then": [
        {
          "reveal_map": {
            "global_val": "berserk_flora_location"
          },
          "radius": 1
        },
        {
          "if": {
            "math": [
              "berserk_flora_stage == 3"
            ]
          },
          "then": {
            "u_message": "Flora's burned manor is marked on your map. Its protection and peaceful meeting are gone. Recover at your refuge and follow your remaining hunts.",
            "type": "info",
            "popup": true
          },
          "else": {
            "u_message": "Flora's manor is marked on your map. She can explain the Brand and the armor even if you already own a complete set.",
            "type": "info",
            "popup": true
          }
        }
      ],
      "else": {
        "run_eocs": "EOC_BERSERK_FLORA_FIND"
      }
    }
  },
