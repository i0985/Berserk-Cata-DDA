        }
      ]
    },
    "effect": [
      {
        "if": {
          "not": {
            "math": [
              "has_var(u_berserk_local_breach_location)"
            ]
          }
        },
        "then": {
          "u_location_variable": {
            "u_val": "berserk_local_breach_location"
          },
          "x_adjust": {
            "math": [
              "floor(u_val('pos_x') / 24) * 24 - u_val('pos_x') + 0"
            ]
          },
          "y_adjust": {
            "math": [
              "floor(u_val('pos_y') / 24) * 24 - u_val('pos_y') + 0"
            ]
          }
        }
      },
      {
        "math": [
          "u_berserk_breach_marked = 1"
        ]
      },
      {
        "u_location_variable": {
          "context_val": "berserk_arena_existing"
        },
        "monster": "mon_berserk_breach_warden",
        "target_max_radius": 60,
        "true_eocs": [
          "EOC_BERSERK_BREACH_ADOPT"
        ],
        "false_eocs": [
          "EOC_BERSERK_BREACH_TRY_HIDDEN"
        ]
      }
    ]
  },
