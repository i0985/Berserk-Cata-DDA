        },
        {
          "or": [
            {
              "not": {
                "math": [
                  "has_var(u_berserk_local_breach_location)"
                ]
              }
            },
            {
              "and": [
                {
                  "math": [
                    "floor(u_berserk_local_breach_location.x / 24) == floor(u_val('pos_x') / 24)"
