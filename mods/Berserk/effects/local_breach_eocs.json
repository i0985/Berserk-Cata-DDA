[
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BREACH_READ_CLUE",
    "condition": "u_is_avatar",
    "effect": [
      {
        "u_message": "Между обгоревшими краями различимы оборванная дорога, разрушенный фундамент и отметки вокруг расселины. Существо из низины носило этот путь к другому прорыву.",
        "type": "info",
        "popup": true
      },
      {
        "if": {
          "not": {
            "math": [
              "u_berserk_journal_read_berserk_apostle_burned_clue == 1"
            ]
          }
        },
        "then": [
          {
            "math": [
              "u_berserk_journal_read_berserk_apostle_burned_clue = 1"
            ]
          },
          {
            "run_eocs": "EOC_BERSERK_JOURNAL_LEARN_BREACH"
          },
          {
            "run_eocs": "EOC_BERSERK_JOURNAL_BREACH_LOCATE"
          },
          {
            "run_eocs": "EOC_BERSERK_CAMPAIGN_GIVE_JOURNAL"
          }
        ]
      },
      {
        "run_eocs": "EOC_BERSERK_REF_SYNC"
      }
    ],
    "//": "Reference journal: physical source only; rereading never reapplies progression."
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_BREACH_FIND",
    "effect": [
      {
        "if": {
          "or": [
            {
              "math": [
                "u_berserk_site_breach_placement_v31 != 1"
              ]
            },
            {
              "math": [
                "has_var(u_berserk_site_breach_search_origin) == 0"
              ]
            },
            {
              "math": [
                "distance('u', u_berserk_site_breach_search_origin) >= 24"
              ]
            }
          ]
        },
        "then": [
          {
            "math": [
              "u_berserk_site_breach_tries = 0"
            ]
          },
          {
            "math": [
              "u_berserk_site_breach_placement_v31 = 1"
            ]
          },
          {
            "u_location_variable": {
              "u_val": "berserk_site_breach_search_origin"
            }
          }
        ]
      },
      {
        "if": {
          "math": [
            "u_berserk_site_breach_tries < 2"
          ]
        },
        "then": [
          {
            "math": [
              "u_berserk_site_breach_tries = u_berserk_site_breach_tries + 1"
            ]
          },
          {
            "if": {
              "math": [
                "u_berserk_site_breach_tries == 1"
              ]
            },
            "then": {
              "u_location_variable": {
                "context_val": "berserk_site_breach_candidate"
              },
              "target_params": {
                "om_terrain": "berserk_local_breach",
                "om_special": "berserk_local_breach_special",
                "search_range": 24,
                "random": true,
                "min_distance": 0,
                "z": 0
              },
              "true_eocs": [
                "EOC_BERSERK_SITE_BREACH_VALIDATE"
              ],
              "false_eocs": [
                "EOC_BERSERK_SITE_BREACH_FAILED"
              ]
            },
            "else": {
              "u_location_variable": {
                "context_val": "berserk_site_breach_candidate"
              },
              "target_params": {
                "om_terrain": "berserk_local_breach",
                "om_special": "berserk_local_breach_special",
                "search_range": 48,
                "random": true,
                "min_distance": 0,
                "z": 0
              },
              "true_eocs": [
                "EOC_BERSERK_SITE_BREACH_VALIDATE"
              ],
              "false_eocs": [
                "EOC_BERSERK_SITE_BREACH_FAILED"
              ]
            }
          }
        ],
        "else": {
          "run_eocs": "EOC_BERSERK_SITE_BREACH_MESSAGE"
        }
      }
    ]
  },
