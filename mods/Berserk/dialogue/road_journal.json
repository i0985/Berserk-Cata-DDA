      },
      {
        "text": "Recall the misty valley.",
        "topic": "TALK_BERSERK_ROAD_JOURNAL",
        "condition": {
          "or": [
            {
              "math": [
                "berserk_hunt_rosine_state >= 1"
              ]
            },
            {
              "u_has_item": "berserk_apostle_hunt_journal"
            }
          ]
        },
        "effect": {
          "run_eocs": "EOC_BERSERK_ROSINE_SEEK"
        }
      },
      {
        "text": "Recall Flora's grove.",
        "topic": "TALK_BERSERK_ROAD_JOURNAL",
        "condition": {
          "test_eoc": "EOC_BERSERK_FLORA_ROUTE_AVAILABLE"
