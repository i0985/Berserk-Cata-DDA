        "effect": {
          "run_eocs": "EOC_BERSERK_FLORA_SEEK"
        }
      },
      {
        "text": "Recall Grunbeld's stronghold.",
        "topic": "TALK_BERSERK_ROAD_JOURNAL",
        "condition": {
          "or": [
            {
              "math": [
                "u_berserk_flora_escaped == 1"
