[
  {
    "type": "talk_topic",
    "id": "TALK_BERSERK_ROAD_JOURNAL",
    "dynamic_line": "*The notes preserve roads you have learned and work you have not finished. Choose an entry.",
    "responses": [
      {
        "text": "Review the journey so far.",
        "topic": "TALK_BERSERK_ROAD_JOURNAL",
        "condition": {
          "math": [
            "berserk_eclipse_era == 1"
          ]
        },
        "effect": {
          "run_eocs": "EOC_BERSERK_CAMPAIGN_REPORT"
        }
      },
      {
        "text": "Find Godot and Rickert.",
        "topic": "TALK_BERSERK_ROAD_JOURNAL",
        "effect": {
          "run_eocs": "EOC_BERSERK_GODO_SEEK"
        }
      },
      {
        "text": "Review forge orders.",
        "topic": "TALK_BERSERK_JOURNAL_ORDERS"
      },
      {
        "text": "Recall the first hunt.",
        "topic": "TALK_BERSERK_ROAD_JOURNAL",
