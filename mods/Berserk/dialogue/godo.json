      {
        "text": "Show you an uninstalled damaged cannon.",
        "topic": "TALK_BERSERK_RICKERT_CARE",
        "condition": {
          "test_eoc": "EOC_BERSERK_GODO_AT_RICKERT_FORGE"
        },
        "effect": {
          "run_eocs": "EOC_BERSERK_RICKERT_REPAIR_PICK"
        }
