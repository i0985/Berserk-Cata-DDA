#: missions/named_hunts.json effects/apostle_committed_attacks.json effects/hunt_site_placement_eocs.json
msgid "No suitable separated site was registered. Search is limited to three attempts from this position. Consult the trail near the previous story site, or move at least one overmap tile and try again. Known locations are kept unchanged."
msgstr ""

