msgid "Recovering after a committed attack"
msgstr ""

#: missions/named_hunts.json effects/apostle_committed_attacks.json effects/hunt_site_placement_eocs.json
msgid "This creature has fixed its attack direction. The marked area will be struck in three seconds; move out of it before the attack."
msgstr ""

#: missions/named_hunts.json effects/apostle_committed_attacks.json effects/hunt_site_placement_eocs.json
msgid "This creature must recover after committing to its marked attack. This is a brief opening to reposition or counterattack."
msgstr ""

#: missions/named_hunts.json effects/apostle_committed_attacks.json effects/hunt_site_placement_eocs.json
msgid "Visit Flora at the marked manor. Ask about the Brand and your armor, prepare deliberately, and confirm readiness before starting the attack. Escape by the western road or southern garden. Already owning armor does not block the conversation or preparation."
msgstr ""

#: missions/named_hunts.json effects/apostle_committed_attacks.json effects/hunt_site_placement_eocs.json
msgid "Grunbeld raises his hammer! Leave the marked sector before the sweep lands in three seconds!"
msgstr ""

#: missions/named_hunts.json effects/apostle_committed_attacks.json effects/hunt_site_placement_eocs.json
msgid "Wyald lowers his body for a rush! Move sideways from the marked path; he charges in three seconds!"
msgstr ""

#: missions/named_hunts.json effects/apostle_committed_attacks.json effects/hunt_site_placement_eocs.json
msgid "Rosine folds her wings for a dive! Move sideways from the marked path before she dives in three seconds!"
msgstr ""

#: missions/named_hunts.json effects/apostle_committed_attacks.json effects/hunt_site_placement_eocs.json
msgid "The Count coils for a sweep! Leave the marked sector before the blow lands in three seconds!"
msgstr ""

