msgstr ""

#: effects/grunbeld_breath_eocs.json effects/grunbeld_combat_effects.json spells/grunbeld_breath.json fields/grunbeld_breath.json monsters/apostle_grunbeld.json monster_special_attacks/grunbeld_attacks.json
msgid "The dragon is braced. The marked path will burn after three seconds; its aim is fixed. Move sideways or behind solid cover."
msgstr ""

#: effects/grunbeld_breath_eocs.json effects/grunbeld_combat_effects.json spells/grunbeld_breath.json fields/grunbeld_breath.json monsters/apostle_grunbeld.json monster_special_attacks/grunbeld_attacks.json
msgid "Recovering after dragonfire"
msgstr ""

#: effects/grunbeld_breath_eocs.json effects/grunbeld_combat_effects.json spells/grunbeld_breath.json fields/grunbeld_breath.json monsters/apostle_grunbeld.json monster_special_attacks/grunbeld_attacks.json
msgid "The dragon pauses after releasing or interrupting its breath. This is a brief opening to move or counterattack."
