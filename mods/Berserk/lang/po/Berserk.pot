#: effects/grunbeld_breath_eocs.json effects/grunbeld_combat_effects.json spells/grunbeld_breath.json fields/grunbeld_breath.json monsters/apostle_grunbeld.json monster_special_attacks/grunbeld_attacks.json
msgid "Grunbeld: gather dragonfire"
msgstr ""

#: effects/grunbeld_breath_eocs.json effects/grunbeld_combat_effects.json spells/grunbeld_breath.json fields/grunbeld_breath.json monsters/apostle_grunbeld.json monster_special_attacks/grunbeld_attacks.json
msgid "Fix a hostile target cell and begin a three-second breath preparation."
msgstr ""

#: effects/grunbeld_breath_eocs.json effects/grunbeld_combat_effects.json spells/grunbeld_breath.json fields/grunbeld_breath.json monsters/apostle_grunbeld.json monster_special_attacks/grunbeld_attacks.json
msgid "Grunbeld: threatened path"
msgstr ""

#: effects/grunbeld_breath_eocs.json effects/grunbeld_combat_effects.json spells/grunbeld_breath.json fields/grunbeld_breath.json monsters/apostle_grunbeld.json monster_special_attacks/grunbeld_attacks.json
msgid "Mark the fixed breath path without dealing damage."
msgstr ""

#: effects/grunbeld_breath_eocs.json effects/grunbeld_combat_effects.json spells/grunbeld_breath.json fields/grunbeld_breath.json monsters/apostle_grunbeld.json monster_special_attacks/grunbeld_attacks.json
msgid "Grunbeld: fixed dragonfire"
msgstr ""

#: effects/grunbeld_breath_eocs.json effects/grunbeld_combat_effects.json spells/grunbeld_breath.json fields/grunbeld_breath.json monsters/apostle_grunbeld.json monster_special_attacks/grunbeld_attacks.json
msgid "Release heat along the previously marked line. Solid obstacles stop the jet."
msgstr ""

#: effects/grunbeld_breath_eocs.json effects/grunbeld_combat_effects.json spells/grunbeld_breath.json fields/grunbeld_breath.json monsters/apostle_grunbeld.json monster_special_attacks/grunbeld_attacks.json
msgid "marked dragonfire path"
msgstr ""

#: effects/grunbeld_breath_eocs.json effects/grunbeld_combat_effects.json spells/grunbeld_breath.json fields/grunbeld_breath.json monsters/apostle_grunbeld.json monster_special_attacks/grunbeld_attacks.json
msgid "dragonfire burst"
msgstr ""

#: effects/grunbeld_breath_eocs.json effects/grunbeld_combat_effects.json spells/grunbeld_breath.json fields/grunbeld_breath.json monsters/apostle_grunbeld.json monster_special_attacks/grunbeld_attacks.json
msgid "Dragonfire roars along the marked path!"
msgstr ""

