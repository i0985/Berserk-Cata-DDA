    "id": "MISSION_BERSERK_COUNT",
    "name": "The Count's residence",
    "description": "Reach the Count's residence and confront him below the execution hall. After defeating him, examine the exposed breach in the dungeon, then examine the sealed mark to take the relic. The prisoner and written evidence are optional help; neither is required to close the breach.",
    "goal": "MGOAL_CONDITION",
    "goal_condition": {
      "or": [
        {
          "math": [
            "berserk_hunt_count_state >= 5"
          ]
        },
        {
          "math": [
            "u_berserk_pact_resolved_count == 1"
          ]
        }
      ]
    },
    "difficulty": 4,
    "value": 0,
