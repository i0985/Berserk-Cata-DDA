[
  {
    "type": "mission_definition",
    "id": "MISSION_BERSERK_BREACH",
    "name": "Close the ashen breach",
    "description": "Reach the marked ashen breach and defeat its guardian. Then examine the exposed wound in the earth to close it. Examine the quieted mark afterward to collect what remains. Closing this passage reveals the next known hunts in your mission list.",
    "goal": "MGOAL_CONDITION",
    "goal_condition": {
      "math": [
        "u_berserk_breach_sealed == 1"
      ]
    },
    "difficulty": 4,
    "value": 0,
    "origins": [
      "ORIGIN_GAME_START"
    ],
    "has_generic_rewards": false,
    "invisible_on_complete": false,
    "start": {
      "assign_mission_target": {
        "om_terrain": "berserk_local_breach",
        "var": {
          "u_val": "berserk_local_breach_location"
        },
        "reveal_radius": 0
      }
    }
  },
  {
