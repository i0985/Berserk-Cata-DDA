  {
    "type": "mission_definition",
    "id": "MISSION_BERSERK_COUNT",
    "name": "The Count's residence",
    "description": "Descend below the execution hall and defeat the Count. Search his remains and examine the exposed breach at the north end of the dungeon to seal it. The prisoner and records are optional.",
    "goal": "MGOAL_CONDITION",
    "goal_condition": {
      "or": [
        {
          "math": [
            "berserk_hunt_count_state >= 5"
          ]
        },
        {
          "math": [
            "u_berserk_pact_resolved_count == 1"
          ]
        }
      ]
    },
    "difficulty": 4,
    "value": 0,
    "origins": [
