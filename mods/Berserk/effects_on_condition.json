    "effect": [
      { "u_add_effect": "bleed", "intensity": 1, "duration": "2 turns" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ZODD_PURSUER",
    "effect": [
