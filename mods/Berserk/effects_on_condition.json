    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_ARMOR_ACTIVE",
    "recurrence": "1 turn",
    "condition": { "u_is_wearing": "berserk_chestplate" },
    "effect": [
      { "u_add_effect": "berserk_armor_active", "intensity": 1, "duration": "2 turns" }
    ],
    "false_effect": [
      { "u_lose_effect": "berserk_armor_active" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BEAST_OF_DARKNESS",
    "recurrence": "600 turns",
    "condition": { "u_has_effect": "berserk_armor_active" },
    "effect": [
      {
        "switch": { "math": [ "rand(5)" ] },
        "cases": [
          {
            "case": 0,
            "effect": { "u_spawn_monster": "mon_beast_of_darkness_1", "real_count": 1, "min_radius": 5, "max_radius": 10 }
          },
          {
            "case": 1,
            "effect": { "u_spawn_monster": "mon_beast_of_darkness_2", "real_count": 1, "min_radius": 5, "max_radius": 10 }
          },
          {
            "case": 2,
            "effect": { "u_spawn_monster": "mon_beast_of_darkness_3", "real_count": 1, "min_radius": 5, "max_radius": 10 }
          },
          {
            "case": 3,
            "effect": { "u_spawn_monster": "mon_beast_of_darkness_4", "real_count": 1, "min_radius": 5, "max_radius": 10 }
          },
          {
            "case": 4,
            "effect": { "u_spawn_monster": "mon_beast_of_darkness_5", "real_count": 1, "min_radius": 5, "max_radius": 10 }
          },
          {
            "case": 5,
            "effect": { "u_spawn_monster": "mon_beast_of_darkness_6", "real_count": 1, "min_radius": 5, "max_radius": 10 }
          }
        ]
      },
      {
        "u_message": "The darkness within the armor comes alive and lunges at you!",
        "type": "warning"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_GRIFFITH_REBORN",
    "recurrence": "1 d",
    "condition": { "u_has_effect": "berserk_armor_active" },
    "effect": [
      {
        "if": { "x_in_y_chance": { "x": 1, "y": 100 } },
        "then": [
          {
            "u_spawn_monster": "mon_griffith_reborn",
            "real_count": 1,
            "min_radius": 5,
            "max_radius": 10,
            "outdoor_only": true
          },
          {
            "u_message": "Reborn Griffith appears in a flare of dark power!",
            "type": "warning",
            "popup": true
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BERSERK_GRIFFITH_CONFRONTATION",
    "effect": [
      {
        "u_spawn_monster": "mon_griffith_reborn",
        "real_count": 1,
        "min_radius": 5,
        "max_radius": 10,
        "outdoor_only": true
      },
      {
        "u_message": "Reborn Griffith stands before you—his wings gleam and his gaze is cold with resolve. The second encounter has begun!",
        "type": "warning",
        "popup": true
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_TAINTED_FLESH_POISON",
    "eoc_type": "EVENT",
    "required_event": "character_consumes_item",
    "condition": { "compare_string": [ "tainted_flesh", { "context_val": "itype" } ] },
    "effect": [
      {
        "u_add_effect": "poison",
        "duration": "60 turns"
      },
      {
        "u_message": "Poison from the Beast of Darkness' flesh courses through you!",
        "type": "bad"
      }
    ]
  }
]
